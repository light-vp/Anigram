{
  "$schema": "https://raw.githubusercontent.com/light-vp/Anigram/main/schema/scene.v1.json",
  "anigram": 1,
  "id": "distillation-pid",
  "title": "Distillation column",
  "subtitle": "Feed is strained, pumped and preheated into a trayed column; the overhead is condensed into a reflux drum and both products leave on level control",
  "sheet": "PID-002",
  "drawing": "pid",
  "titleBlock": {
    "owner": "Anigram examples",
    "project": "Reference sheets",
    "drawnBy": "Anigram",
    "issued": "2026-10-18",
    "revision": "A",
    "status": "for review"
  },
  "size": [11, 5],
  "units": {
    "water": {
      "rate": "m³/h",
      "amount": "m³"
    }
  },
  "scale": {
    "water": 80
  },
  "clock": {
    "start": 5,
    "rate": 1
  },
  "parts": [
    {
      "id": "feed",
      "kind": "well",
      "label": "Feed from storage",
      "at": [0, 3],
      "behaviour": {
        "role": "source",
        "output": 70
      }
    },
    {
      "id": "y101",
      "kind": "valve",
      "label": "Feed strainer",
      "tag": "Y-101",
      "class": "Strainer",
      "at": [1, 3],
      "labelSide": "above",
      "behaviour": {
        "role": "gate",
        "capacity": 200
      }
    },
    {
      "id": "p101",
      "kind": "pump",
      "label": "Feed pump",
      "tag": "P-101",
      "class": "CentrifugalPump",
      "at": [2, 3],
      "behaviour": {
        "role": "gate",
        "capacity": 80,
        "open": 1
      }
    },
    {
      "id": "e101",
      "kind": "valve",
      "label": "Feed preheater",
      "tag": "E-101",
      "class": "TubularHeatExchanger",
      "at": [3, 3],
      "behaviour": {
        "role": "gate",
        "capacity": 200
      },
      "note": "Warms the feed against the hot bottoms before it reaches the column; the heat itself is not modelled here."
    },
    {
      "id": "c101",
      "kind": "hottank",
      "label": "Column",
      "tag": "C-101",
      "class": "ProcessColumn",
      "at": [5, 3.15],
      "labelSide": "left",
      "behaviour": {
        "role": "storage",
        "capacity": 30,
        "start": 0.5,
        "maxIn": 100,
        "maxOut": 100
      },
      "note": "The lighter part of the feed rises through the trays as vapour; the heavier part falls to the sump."
    },
    {
      "id": "e102",
      "kind": "valve",
      "label": "Overhead condenser",
      "tag": "E-102",
      "class": "AirCoolingSystem",
      "at": [5, 1],
      "labelSide": "left",
      "behaviour": {
        "role": "gate",
        "capacity": 200
      }
    },
    {
      "id": "d101",
      "kind": "hottank",
      "label": "Reflux drum",
      "tag": "D-101",
      "class": "HorizontalVessel",
      "at": [7, 1],
      "labelSide": "below",
      "behaviour": {
        "role": "storage",
        "capacity": 8,
        "start": 0.5,
        "maxIn": 100,
        "maxOut": 100,
        "refill": {
          "below": 0.4,
          "until": 0.8
        }
      }
    },
    {
      "id": "p102",
      "kind": "pump",
      "label": "Distillate pump",
      "tag": "P-102",
      "class": "CentrifugalPump",
      "at": [8, 1],
      "labelSide": "above",
      "behaviour": {
        "role": "gate",
        "capacity": 80,
        "open": 1
      }
    },
    {
      "id": "fv101",
      "kind": "valve",
      "label": "Distillate valve",
      "tag": "LV-101",
      "class": "ControlValve",
      "fails": "closed",
      "at": [9, 1],
      "labelSide": "below",
      "behaviour": {
        "role": "gate",
        "capacity": 100,
        "open": "clamp((prev('d101').fill - 0.3) / 0.4, 0, 1)"
      },
      "note": "Opens as the drum fills, so the drum holds about half full; it shuts if its air fails."
    },
    {
      "id": "dist",
      "kind": "tap",
      "label": "Distillate to storage",
      "at": [10, 1],
      "labelSide": "below",
      "behaviour": {
        "role": "sink",
        "demand": 30
      }
    },
    {
      "id": "lv102",
      "kind": "valve",
      "label": "Bottoms valve",
      "tag": "LV-102",
      "class": "ControlValve",
      "actuator": "piston",
      "fails": "last",
      "at": [7, 3.15],
      "behaviour": {
        "role": "gate",
        "capacity": 100,
        "open": "clamp((prev('c101').fill - 0.3) / 0.4, 0, 1)"
      },
      "labelSide": "above"
    },
    {
      "id": "v101",
      "kind": "valve",
      "label": "Bottoms isolation",
      "tag": "V-101",
      "class": "GateValve",
      "actuator": "hand",
      "at": [9, 3.15],
      "behaviour": {
        "role": "gate",
        "capacity": 200,
        "open": 1
      }
    },
    {
      "id": "bottoms",
      "kind": "tap",
      "label": "Bottoms to storage",
      "at": [10, 3.15],
      "labelSide": "below",
      "behaviour": {
        "role": "sink",
        "demand": 35
      }
    }
  ],
  "links": [
    {
      "from": "feed",
      "to": "y101",
      "domain": "water",
      "tag": "100-P-001"
    },
    {
      "from": "y101",
      "to": "p101",
      "domain": "water"
    },
    {
      "from": "p101",
      "to": "e101",
      "domain": "water",
      "tag": "80-P-002"
    },
    {
      "from": "e101",
      "to": "c101",
      "domain": "water",
      "tag": "80-P-003"
    },
    {
      "from": "c101",
      "to": "e102",
      "domain": "water",
      "tag": "150-P-004"
    },
    {
      "from": "e102",
      "to": "d101",
      "domain": "water",
      "tag": "100-P-005"
    },
    {
      "from": "d101",
      "to": "p102",
      "domain": "water",
      "tag": "80-P-006"
    },
    {
      "from": "p102",
      "to": "fv101",
      "domain": "water"
    },
    {
      "from": "fv101",
      "to": "dist",
      "domain": "water",
      "tag": "50-P-007"
    },
    {
      "from": "c101",
      "to": "lv102",
      "domain": "water",
      "tag": "80-P-008"
    },
    {
      "from": "lv102",
      "to": "v101",
      "domain": "water"
    },
    {
      "from": "v101",
      "to": "bottoms",
      "domain": "water",
      "tag": "80-P-009"
    }
  ],
  "instruments": [
    {
      "tag": "PI-101",
      "at": [2, 2],
      "measures": "p101"
    },
    {
      "tag": "LT-101",
      "at": [7, 0],
      "measures": "d101",
      "low": 20,
      "high": 90
    },
    {
      "tag": "LIC-101",
      "at": [9, 0],
      "measures": "LT-101",
      "drives": "fv101",
      "mounting": "dcs",
      "low": 20,
      "high": 90
    },
    {
      "tag": "LT-102",
      "at": [5, 4.5],
      "measures": "c101"
    },
    {
      "tag": "LIC-102",
      "at": [7, 4.5],
      "measures": "LT-102",
      "drives": "lv102",
      "mounting": "dcs",
      "signal": "pneumatic"
    }
  ],
  "expect": [
    {
      "says": "The column never runs dry",
      "check": "part('c101').fill > 0.1"
    },
    {
      "says": "The reflux drum never runs dry",
      "check": "part('d101').fill > 0.1"
    }
  ]
}
