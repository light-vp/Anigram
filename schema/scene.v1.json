{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/light-vp/Anigram/main/schema/scene.v1.json",
  "title": "Anigram scene",
  "description": "A living diagram: parts on a grid, the links between them, and the signals that drive them. Format version 1.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "anigram": {
      "const": 1,
      "description": "the format version this file is written in"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "sheet": {
      "type": "string",
      "description": "drawing number, like LD-101"
    },
    "drawing": {
      "enum": [
        "pictorial",
        "pid",
        "single-line",
        "pfd",
        "fluid-power"
      ],
      "description": "the drawing practice the sheet follows: pictorial (the default), pid, single-line, pfd or fluid-power"
    },
    "symbols": {
      "enum": [
        "iec",
        "ansi"
      ],
      "description": "a single-line's symbol standard: IEC 60617 (the default) or ANSI/IEEE 315"
    },
    "titleBlock": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1,
          "description": "the organisation the drawing belongs to"
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "drawnBy": {
          "type": "string",
          "minLength": 1
        },
        "checkedBy": {
          "type": "string",
          "minLength": 1
        },
        "approvedBy": {
          "type": "string",
          "minLength": 1
        },
        "issued": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "date of issue, YYYY-MM-DD"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "description": "e.g. \"for review\""
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "size": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 40
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "grid columns × rows"
    },
    "units": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "light",
          "electric",
          "water",
          "heat",
          "fuel",
          "mechanical",
          "data",
          "oil",
          "air"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "rate": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "rate",
          "amount"
        ],
        "additionalProperties": false
      }
    },
    "scale": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "light",
          "electric",
          "water",
          "heat",
          "fuel",
          "mechanical",
          "data",
          "oil",
          "air"
        ]
      },
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "description": "which drawing to use",
            "examples": [
              "sun",
              "wind",
              "pv",
              "gaswell",
              "core",
              "grid",
              "rain",
              "air",
              "transformer",
              "inverter",
              "turbine",
              "generator",
              "turbogen",
              "gasplant",
              "pump",
              "heatpump",
              "motor",
              "powerpack",
              "compressor",
              "servers",
              "busbar",
              "manifold",
              "breaker",
              "valve",
              "pylon",
              "dcv",
              "battery",
              "reservoir",
              "watertower",
              "hottank",
              "fueltank",
              "oiltank",
              "accumulator",
              "well",
              "treatment",
              "tap",
              "hydrant",
              "river",
              "weir",
              "house",
              "city",
              "hospital",
              "factory",
              "radiator",
              "car",
              "cylinder",
              "globe",
              "coolingtower",
              "sky",
              "fan"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "[column, row] on the grid, zero-based"
          },
          "behaviour": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "role": {
                    "const": "source"
                  },
                  "output": {
                    "description": "a number, or an expression of the hour and the controls, like \"32 * sun(hour) * (1 - 0.85 * knob('cloud'))\"",
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      }
                    ]
                  },
                  "dispatchable": {
                    "type": "boolean"
                  },
                  "merit": {
                    "type": "number"
                  }
                },
                "required": [
                  "role",
                  "output"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "role": {
                    "const": "sink"
                  },
                  "demand": {
                    "description": "a number, or an expression of the hour and the controls, like \"32 * sun(hour) * (1 - 0.85 * knob('cloud'))\"",
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      }
                    ]
                  },
                  "priority": {
                    "type": "number"
                  },
                  "absorbsSurplus": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "role",
                  "demand"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "role": {
                    "const": "bus"
                  }
                },
                "required": [
                  "role"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "role": {
                    "const": "gate"
                  },
                  "capacity": {
                    "type": "number",
                    "minimum": 0
                  },
                  "open": {
                    "description": "a number, or an expression of the hour and the controls, like \"32 * sun(hour) * (1 - 0.85 * knob('cloud'))\"",
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      }
                    ]
                  }
                },
                "required": [
                  "role",
                  "capacity"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "role": {
                    "const": "converter"
                  },
                  "output": {
                    "enum": [
                      "light",
                      "electric",
                      "water",
                      "heat",
                      "fuel",
                      "mechanical",
                      "data",
                      "oil",
                      "air"
                    ]
                  },
                  "recipe": {
                    "type": "object",
                    "propertyNames": {
                      "enum": [
                        "light",
                        "electric",
                        "water",
                        "heat",
                        "fuel",
                        "mechanical",
                        "data",
                        "oil",
                        "air"
                      ]
                    },
                    "additionalProperties": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "minProperties": 1,
                    "description": "how much of each input one unit of output takes"
                  },
                  "capacity": {
                    "type": "number",
                    "minimum": 0
                  },
                  "startup": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "role",
                  "output",
                  "recipe"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "role": {
                    "const": "storage"
                  },
                  "capacity": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "start": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "maxIn": {
                    "description": "a number, or an expression of the hour and the controls, like \"32 * sun(hour) * (1 - 0.85 * knob('cloud'))\"",
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      }
                    ]
                  },
                  "maxOut": {
                    "description": "a number, or an expression of the hour and the controls, like \"32 * sun(hour) * (1 - 0.85 * knob('cloud'))\"",
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      }
                    ]
                  },
                  "efficiency": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "merit": {
                    "type": "number"
                  },
                  "refill": {
                    "type": "object",
                    "properties": {
                      "below": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "until": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "required": [
                      "below",
                      "until"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "role",
                  "capacity",
                  "maxIn",
                  "maxOut"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "role": {
                    "const": "vent"
                  }
                },
                "required": [
                  "role"
                ],
                "additionalProperties": false
              }
            ]
          },
          "note": {
            "type": "string"
          },
          "labelSide": {
            "enum": [
              "below",
              "above",
              "left",
              "right"
            ]
          },
          "toggles": {
            "type": "string",
            "description": "a switch id"
          },
          "tag": {
            "type": "string",
            "minLength": 1,
            "description": "its tag on an engineering drawing, like P-101 or FIC-101; unique on the sheet"
          },
          "class": {
            "type": "string",
            "minLength": 1,
            "description": "what exactly it is in the drawing practice's vocabulary, like CentrifugalPump; picks the symbol"
          }
        },
        "required": [
          "id",
          "kind",
          "label",
          "at",
          "behaviour"
        ],
        "additionalProperties": false
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "enum": [
              "light",
              "electric",
              "water",
              "heat",
              "fuel",
              "mechanical",
              "data",
              "oil",
              "air"
            ]
          },
          "capacity": {
            "type": "number",
            "minimum": 0
          },
          "via": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "[column, row] on the grid, zero-based"
            }
          },
          "bend": {
            "enum": [
              "hv",
              "vh"
            ]
          },
          "loss": {
            "type": "boolean"
          },
          "line": {
            "enum": [
              "process",
              "utility",
              "signal",
              "pneumatic",
              "data"
            ],
            "description": "how an engineering drawing draws it; process by default, signal for data"
          },
          "tag": {
            "type": "string",
            "minLength": 1,
            "description": "its line number, like 50-W-101"
          }
        },
        "required": [
          "from",
          "to",
          "domain"
        ],
        "additionalProperties": false
      }
    },
    "instruments": {
      "type": "array",
      "description": "instruments, drawn as ISA-5.1 bubbles on a P&ID",
      "items": {
        "type": "object",
        "properties": {
          "tag": {
            "type": "string",
            "pattern": "^[A-Z]",
            "description": "ISA-5.1: what it measures, what it does, then the loop number, like LIC-101"
          },
          "at": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "[column, row] on the grid, zero-based"
          },
          "measures": {
            "type": "string",
            "minLength": 1,
            "description": "the part it is connected to"
          },
          "reads": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "what it reads, like \"part('tank').fill * 100\"; a level or flow instrument reads its part when left out"
          },
          "unit": {
            "type": "string"
          },
          "drives": {
            "type": "string",
            "minLength": 1,
            "description": "the valve or breaker a controller works"
          },
          "signal": {
            "enum": [
              "signal",
              "pneumatic",
              "data"
            ],
            "description": "how its signal to `drives` travels"
          },
          "mounting": {
            "enum": [
              "field",
              "panel",
              "behind-panel",
              "dcs",
              "plc"
            ]
          },
          "low": {
            "type": "number",
            "description": "alarm below this reading"
          },
          "high": {
            "type": "number",
            "description": "alarm above this reading"
          }
        },
        "required": [
          "tag",
          "at",
          "measures"
        ],
        "additionalProperties": false
      }
    },
    "knobs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "step": {
            "type": "number"
          },
          "value": {
            "type": "number"
          },
          "format": {
            "type": "string",
            "description": "{pct} is the value as a percentage, {value} the number"
          }
        },
        "required": [
          "id",
          "label",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "switches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "on": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "label",
          "on"
        ],
        "additionalProperties": false
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "number",
            "minimum": 0,
            "maximum": 24
          },
          "to": {
            "type": "number",
            "minimum": 0,
            "maximum": 24
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "from",
          "to",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "expect": {
      "type": "array",
      "description": "the story as checks on the simulated day; simulate_scene and check_scene report each one",
      "items": {
        "type": "object",
        "properties": {
          "says": {
            "type": "string",
            "minLength": 1,
            "description": "the claim in words"
          },
          "check": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "an expression that is true when the claim holds; part('id').in, .out, .fill or .demand reads a part, e.g. \"part('battery').fill < 0.05\""
          },
          "at": {
            "type": "integer",
            "minimum": 0,
            "maximum": 24,
            "description": "the one hour it must hold at"
          },
          "from": {
            "type": "integer",
            "minimum": 0,
            "maximum": 24,
            "description": "start of a window of hours"
          },
          "to": {
            "type": "integer",
            "minimum": 0,
            "maximum": 24,
            "description": "end of the window, inclusive; wraps past midnight"
          },
          "sometime": {
            "type": "boolean",
            "description": "true: holding at any checked hour is enough"
          }
        },
        "required": [
          "says",
          "check"
        ],
        "additionalProperties": false
      }
    },
    "clock": {
      "type": "object",
      "properties": {
        "start": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "rate": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 24
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "title",
    "size",
    "parts",
    "links"
  ],
  "additionalProperties": false
}
