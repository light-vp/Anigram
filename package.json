{
  "name": "anigram",
  "description": "Living diagrams of real machines — engineering drawings that run. MCP-first: coding assistants write, simulate and draw them; people tune them in the browser.",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "license": "MIT",
  "author": "Vaibhav Patel",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:mcp": "vite build -c mcp/vite.config.ts",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "node --test 'src/**/*.test.ts'",
    "golden:update": "UPDATE_GOLDEN=1 node --test src/format/golden.test.ts",
    "test:mcp": "npm run build:mcp && node --test mcp/smoke.test.mjs mcp/drawings.test.mjs",
    "drawings:update": "npm run build:mcp && UPDATE_DRAWINGS=1 node --test mcp/drawings.test.mjs",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots=all",
    "docs": "npm run build:mcp && node scripts/docs.mjs",
    "docs:check": "npm run build:mcp && node scripts/docs.mjs --check",
    "version:check": "node scripts/check-versions.mjs",
    "eval": "npm run build:mcp && node eval/run.mjs",
    "simulate": "node scripts/simulate-day.ts",
    "bench": "node scripts/bench-solver.ts",
    "schema": "node scripts/write-schema.ts",
    "mcp": "node mcp/dist/anigram-mcp.mjs"
  },
  "dependencies": {
    "@sentry/react": "^11.8.0",
    "posthog-js": "^1.438.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "1.56.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "zod": "^4.6.5"
  }
}
