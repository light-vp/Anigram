  "expect": [
    {
      "says": "feed enters and bottoms leave the column through LV-1103",
      "check": "part('btm').in > 0 && part('feed').out > 0"
    },
    {
      "says": "the column sump level stays controlled",
      "check": "part('col').fill > 0.15 && part('col').fill < 0.9"
    },
    {
      "says": "the reflux drum level is held, never empty",
      "check": "part('drum').fill > 0.1 && part('drum').fill < 0.95"
    },
    {
      "says": "reflux returns to the column and distillate leaves off the sheet",
      "check": "part('fv').out > 0 && part('dist').in > 0",
      "from": 12,
      "to": 24
    },
    {
      "says": "steam heats the reboiler",
      "check": "part('reb').out > 0"
    },
    {
      "says": "cooling water flows to the condenser",
      "check": "part('pv').out > 0",
      "from": 12,
      "to": 24
    }
  ]
