  "captions": [
    {
      "from": 0,
      "to": 5.5,
      "text": "Night: low main flow, P-301A strokes slowly and the day tank barely moves."
    },
    {
      "from": 5.5,
      "to": 10,
      "text": "Morning peak: FT-301 sees the main flow rise and FIC-301 raises P-301A's stroke speed."
    },
    {
      "from": 10,
      "to": 17,
      "text": "Midday: dose settles back to the base rate."
    },
    {
      "from": 17,
      "to": 21,
      "text": "Evening peak: dose rises again with the main flow."
    },
    {
      "from": 21,
      "to": 24,
      "text": "The day tank has run down but never dry; P-301B stands by."
    }
  ],
  "expect": [
    {
      "says": "at night the dose is at its low base rate",
      "check": "part('p301a').out < 4",
      "at": 3
    },
    {
      "says": "the morning peak raises the dose well above base",
      "check": "part('p301a').out > 8",
      "from": 7,
      "to": 8
    },
    {
      "says": "the dose is back near base at midday",
      "check": "part('p301a').out < 5",
      "at": 13
    },
    {
      "says": "the evening peak raises the dose again",
      "check": "part('p301a').out > 8",
      "at": 19
    },
    {
      "says": "dose follows the main flow (15 mL per m3)",
      "check": "abs(part('p301a').out - 0.000015 * part('main').out) < 0.6"
    },
    {
      "says": "the day tank runs down over the day",
      "check": "part('t301').fill < 0.85",
      "at": 23
    },
    {
      "says": "the day tank never runs dry",
      "check": "part('t301').fill > 0.2"
    },
    {
      "says": "standby pump P-301B stays idle",
      "check": "part('p301b').out == 0"
    }
  ]
}
