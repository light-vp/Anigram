  ],
  "switches": [
    {
      "id": "standbyIn",
      "label": "F-901B isolating valves open",
      "on": false
    },
    {
      "id": "drainA",
      "label": "F-901A drain open",
      "on": false
    },
    {
      "id": "drainB",
      "label": "F-901B drain open",
      "on": false
    }
  ],
  "expect": [
    {
      "says": "oil reaches the bearings through the in-service filter F-901A",
      "check": "part('out').in >= 0.999 * part('out').demand"
    },
    {
      "says": "F-901A carries the whole flow",
      "check": "part('fa').out > 70"
    },
    {
      "says": "standby filter F-901B passes no oil while isolated",
      "check": "part('fb').out < 0.001"
    },
    {
      "says": "no oil is lost to the drains with the drain valves shut",
      "check": "part('dra').in < 0.001 && part('drb').in < 0.001"
    },
    {
      "says": "differential pressure across F-901A stays under the high alarm setting",
      "check": "part('vai').effort - part('vao').effort < 1"
    }
  ]
}
