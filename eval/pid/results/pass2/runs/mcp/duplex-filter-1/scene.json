      },
      "labelSide": "left",
      "tag": "J-901",
      "class": "Junction"
    },
    {
      "id": "vai",
      "kind": "valve",
      "label": "A inlet",
      "at": [2, 1],
      "behaviour": {
        "role": "gate",
        "capacity": 120,
        "open": 1
      },
      "labelSide": "below",
      "tag": "V-901A1",
      "class": "GateValve"
    },
    {
      "id": "fa",
      "kind": "valve",
      "label": "Filter A",
      "at": [3, 1],
      "behaviour": {
        "role": "gate",
        "capacity": 100,
        "open": 1
      },
      "labelSide": "above",
      "tag": "F-901A",
      "class": "Filter",
      "effort": {
        "drop": 0.8
      }
    },
    {
      "id": "vao",
      "kind": "valve",
      "label": "A outlet",
      "at": [4, 1],
      "behaviour": {
        "role": "gate",
        "capacity": 120,
        "open": 1
      },
      "labelSide": "below",
      "tag": "V-901A2",
      "class": "GateValve"
    },
    {
      "id": "dva",
      "kind": "valve",
      "label": "A drain",
      "at": [3, 2],
      "behaviour": {
        "role": "gate",
        "capacity": 10,
        "open": "on('drainA') ? 1 : 0"
      },
      "labelSide": "left",
      "tag": "V-901A3",
      "class": "GateValve"
    },
    {
      "id": "dra",
      "kind": "river",
      "label": "To drain",
      "at": [4, 2],
      "behaviour": {
        "role": "sink",
        "demand": "on('drainA') ? 10 : 0"
      },
      "tag": "OPC-903",
      "class": "OffPageConnector"
    },
    {
      "id": "vbi",
      "kind": "valve",
      "label": "B inlet",
      "at": [2, 5],
      "behaviour": {
        "role": "gate",
        "capacity": 120,
        "open": "on('standbyIn') ? 1 : 0"
      },
      "labelSide": "above",
      "tag": "V-901B1",
      "class": "GateValve"
    },
    {
      "id": "fb",
      "kind": "valve",
      "label": "Filter B",
      "at": [3, 5],
      "behaviour": {
        "role": "gate",
        "capacity": 100,
        "open": 1
      },
      "labelSide": "above",
      "tag": "F-901B",
      "class": "Filter",
      "effort": {
        "drop": 0.8
      }
    },
    {
      "id": "vbo",
      "kind": "valve",
      "label": "B outlet",
