  "instruments": [
    {
      "tag": "PDT-901A",
      "at": [3, 0],
      "measures": "fa",
      "reads": "part('vai').effort - part('vao').effort",
      "unit": "bar",
      "mounting": "field"
    },
    {
      "tag": "PDAH-901A",
      "at": [4, 0],
      "measures": "PDT-901A",
      "reads": "part('vai').effort - part('vao').effort",
      "unit": "bar",
      "signal": "data",
      "mounting": "dcs",
      "high": 1
    },
    {
      "tag": "PDT-901B",
      "at": [3, 4],
      "measures": "fb",
      "reads": "part('vbi').effort - part('vbo').effort",
      "unit": "bar",
      "mounting": "field"
    },
    {
      "tag": "PDAH-901B",
      "at": [4, 4],
      "measures": "PDT-901B",
      "reads": "part('vbi').effort - part('vbo').effort",
      "unit": "bar",
      "signal": "data",
      "mounting": "dcs",
      "high": 1
    },
    {
      "tag": "PG-901",
      "at": [2, 3],
      "measures": "j1",
      "reads": "part('j1').effort",
      "unit": "bar",
      "mounting": "field"
    },
    {
      "tag": "PG-902",
      "at": [4, 3],
      "measures": "j2",
