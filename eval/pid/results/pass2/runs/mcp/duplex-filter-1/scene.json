      "labelSide": "above",
      "tag": "V-901B2",
      "class": "GateValve"
    },
    {
      "id": "dvb",
      "kind": "valve",
      "label": "B drain",
      "at": [3, 6],
      "behaviour": {
        "role": "gate",
        "capacity": 10,
        "open": "on('drainB') ? 1 : 0"
      },
      "labelSide": "left",
      "tag": "V-901B3",
