{
  "anigram": 1,
  "id": "duplex-filter",
  "title": "Duplex lube oil filter set",
  "subtitle": "F-901A in service, F-901B on standby; differential pressure monitored by the DCS",
  "sheet": "PID-901",
  "size": [7, 7],
  "units": {
    "fuel": {
      "rate": "L/min",
