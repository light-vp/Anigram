      "labelSide": "below",
      "tag": "OPC-901",
      "class": "OffPageConnector",
      "effort": {
        "set": 6
      }
    },
    {
      "id": "j1",
      "kind": "manifold",
      "label": "Inlet header",
      "at": [1, 3],
