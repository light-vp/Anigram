{
  "anigram": 1,
  "id": "pressure-measurement",
  "title": "Line pressure measurement",
  "subtitle": "Local gauge PI-045, control-room indicator PI-044 and switches US-046 / US-047",
  "sheet": "PID-100",
  "size": [7, 3],
  "units": {
    "water": {
      "rate": "m³/h",
      "amount": "m³"
    }
  },
  "scale": {
    "water": 100
  },
  "parts": [
    {
      "id": "feed",
      "kind": "river",
      "label": "From upstream",
      "at": [0, 2],
      "behaviour": {
        "role": "source",
        "output": 50
      },
      "effort": {
        "set": 5
      }
    },
    {
      "id": "j1",
      "kind": "manifold",
      "label": "Tap 1",
      "at": [2, 2],
      "behaviour": {
        "role": "bus"
