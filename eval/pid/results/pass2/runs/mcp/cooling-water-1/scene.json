      "on": false
    }
  ],
  "expect": [
    {
      "says": "the duty pump P-601A runs all day",
      "check": "part('pa').out > 100"
    },
    {
      "says": "the standby pump P-601B stays off",
      "check": "part('pb').out < 1"
    },
    {
      "says": "at 6 am TV-601 passes plenty of water to the basin",
      "check": "part('tv').out > 200",
      "at": 6
    },
    {
      "says": "at 3 pm, when it is hotter, TV-601 passes much less",
      "check": "part('tv').out < 100",
      "at": 15
    }
