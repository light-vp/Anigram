{
  "anigram": 1,
  "id": "cooling-water-circuit",
  "title": "Cooling water circuit",
  "subtitle": "Duty/standby circulating pumps, plate exchanger E-601 and a tower bypass under temperature control",
  "sheet": "PID-601",
  "size": [11, 7],
  "units": {
    "water": {
      "rate": "m³/h",
      "amount": "m³"
    },
    "electric": {
      "rate": "kW",
      "amount": "kWh"
    },
    "heat": {
      "rate": "MW",
      "amount": "MWh"
    }
  },
  "scale": {
    "water": 400,
    "electric": 50,
    "heat": 5
  },
  "parts": [
    {
      "id": "power",
      "kind": "grid",
      "label": "Electricity",
      "at": [3, 0],
      "behaviour": {
        "role": "source",
        "output": 100,
        "dispatchable": true
      }
    },
    {
      "id": "ct",
      "kind": "reservoir",
      "label": "Tower basin",
      "at": [1, 3],
      "behaviour": {
        "role": "source",
        "output": 500
      },
      "labelSide": "left",
      "tag": "CT-601",
      "class": "Vessel"
    },
    {
      "id": "sva",
      "kind": "valve",
      "label": "Suction",
      "at": [2, 2],
      "behaviour": {
        "role": "gate",
        "capacity": 400,
        "open": "on('pa') ? 1 : 0"
      },
      "labelSide": "below",
      "tag": "HV-601A",
      "class": "GateValve"
    },
    {
      "id": "svb",
      "kind": "valve",
      "label": "Suction",
      "at": [2, 4],
      "behaviour": {
        "role": "gate",
        "capacity": 400,
        "open": "on('pb') ? 1 : 0"
      },
      "labelSide": "below",
      "tag": "HV-601B",
      "class": "GateValve"
    },
    {
      "id": "pa",
      "kind": "pump",
      "label": "Duty pump",
      "at": [3, 2],
      "behaviour": {
        "role": "converter",
        "output": "water",
        "recipe": {
          "electric": 0.1,
          "water": 1
        },
        "capacity": 400
      },
      "labelSide": "above",
      "tag": "P-601A",
      "class": "CentrifugalPump"
    },
    {
      "id": "pb",
      "kind": "pump",
      "label": "Standby pump",
      "at": [3, 4],
      "behaviour": {
        "role": "converter",
        "output": "water",
        "recipe": {
          "electric": 0.1,
          "water": 1
        },
        "capacity": 400
      },
      "labelSide": "above",
      "tag": "P-601B",
      "class": "CentrifugalPump"
    },
    {
      "id": "ca",
      "kind": "valve",
      "label": "Check",
      "at": [4, 2],
      "behaviour": {
        "role": "gate",
        "capacity": 400,
        "open": 1
      },
      "labelSide": "below",
      "tag": "NRV-601A",
      "class": "CheckValve"
    },
    {
      "id": "cb",
      "kind": "valve",
      "label": "Check",
      "at": [4, 4],
      "behaviour": {
        "role": "gate",
        "capacity": 400,
        "open": 1
      },
      "labelSide": "below",
      "tag": "NRV-601B",
      "class": "CheckValve"
    },
    {
      "id": "da",
      "kind": "valve",
      "label": "Discharge",
      "at": [5, 2],
      "behaviour": {
        "role": "gate",
        "capacity": 400,
        "open": "on('pa') ? 1 : 0"
      },
      "labelSide": "above",
      "tag": "HV-602A",
      "class": "GateValve"
    },
    {
      "id": "db",
      "kind": "valve",
      "label": "Discharge",
      "at": [5, 4],
      "behaviour": {
        "role": "gate",
        "capacity": 400,
        "open": "on('pb') ? 1 : 0"
      },
      "labelSide": "above",
      "tag": "HV-602B",
      "class": "GateValve"
    },
    {
      "id": "hd",
      "kind": "manifold",
      "label": "Supply header",
      "at": [6, 3],
      "behaviour": {
        "role": "bus"
      },
      "tag": "J-601",
      "class": "Junction"
    },
    {
      "id": "e601",
      "kind": "valve",
      "label": "Plate exchanger",
      "at": [7, 3],
      "behaviour": {
        "role": "converter",
        "output": "water",
        "recipe": {
          "water": 1,
          "heat": 0.004
        },
        "capacity": 400
      },
      "labelSide": "below",
      "tag": "E-601",
      "class": "HeatExchanger"
    },
    {
      "id": "rj",
      "kind": "manifold",
      "label": "Return header",
      "at": [9, 3],
      "behaviour": {
        "role": "bus"
      },
      "tag": "J-602",
      "class": "Junction"
    },
    {
      "id": "tv",
      "kind": "valve",
      "label": "Tower bypass valve",
      "at": [9, 5],
      "behaviour": {
        "role": "gate",
        "capacity": 300,
        "open": "clamp((36 - (22 + 12 * bump(hour, 15, 6))) / 14, 0, 1)"
      },
      "tag": "TV-601",
      "class": "ControlValve"
    },
    {
      "id": "pin",
      "kind": "river",
      "label": "Process in",
      "at": [7, 1],
      "behaviour": {
        "role": "source",
        "output": 1.3
      },
      "labelSide": "left",
      "tag": "OPC-601",
      "class": "OffPageConnector"
    },
    {
      "id": "pout",
      "kind": "river",
      "label": "Process out",
      "at": [8, 1],
      "behaviour": {
        "role": "sink",
        "demand": 1.3
      },
      "labelSide": "right",
      "tag": "OPC-602",
      "class": "OffPageConnector"
    },
    {
      "id": "ctt",
      "kind": "coolingtower",
      "label": "Tower top",
      "at": [1, 1],
      "behaviour": {
        "role": "sink",
        "demand": "300 * (1 - clamp((36 - (22 + 12 * bump(hour, 15, 6))) / 14, 0, 1))"
      },
      "labelSide": "left",
      "tag": "CT-601T",
      "class": "Vessel"
    },
    {
      "id": "bs",
      "kind": "reservoir",
      "label": "Bypass to basin",
      "at": [1, 6],
      "behaviour": {
        "role": "sink",
        "demand": "300 * clamp((36 - (22 + 12 * bump(hour, 15, 6))) / 14, 0, 1)"
      },
      "labelSide": "above",
      "tag": "J-603",
      "class": "Junction"
    }
  ],
