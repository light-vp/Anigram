    },
    {
      "tag": "PISZA-275003",
      "at": [0, 6],
      "measures": "PIZ-275003A",
      "mounting": "panel"
    }
  ],
  "knobs": [
    {
      "id": "bottoms",
      "label": "bottoms draw-off",
      "value": 0.6,
      "min": 0,
      "max": 1.5,
      "step": 0.05,
      "format": "{pct}%"
    }
  ],
  "switches": [
    {
      "id": "xv-open",
      "label": "XV-2750 open (click to reset after a trip)",
      "on": true
    },
    {
      "id": "lah-alarm",
      "label": "LAH-2751 alarm active in the DCS",
      "on": false
    },
    {
      "id": "h672b1v-open",
      "label": "H672B1V open",
      "on": false
    }
  ],
  "captions": [
    {
      "from": 6,
      "to": 9,
      "text": "Feed enters through XV-2750 faster than the bottoms leave: the sump level climbs."
    },
    {
      "from": 9,
      "to": 12,
      "text": "LAH-2751 alarms in the DCS; the operator has time to act."
    },
    {
      "from": 12,
      "to": 24,
      "text": "If not, LSHH-2750 closes XV-2750 independently of the DCS and the level falls."
    }
  ],
  "events": [
    {
      "id": "lah",
      "says": "Sump level passes 80 %: LAH-2751 alarms in the DCS.",
      "when": "part('k-2750').fill > 0.8",
      "then": [
        {
          "switch": "lah-alarm",
          "on": true
        }
      ],
      "at": "k-2750"
    },
    {
      "id": "hh-trip",
      "says": "Level reaches 90 %: LSHH-2750 trips and closes XV-2750.",
      "when": "part('k-2750').fill > 0.9",
      "then": [
        {
          "switch": "xv-open",
          "on": false
        }
      ],
      "at": "xv-2750"
    }
  ],
  "expect": [
    {
      "says": "feed runs through XV-2750 into the column before the level alarm",
      "check": "part('xv-2750').out > 50 && part('k-2750').in > 50 && on('lah-alarm') == 0",
      "from": 7,
      "to": 8
    },
    {
      "says": "the high level alarm is raised in the DCS before the trip",
      "check": "on('lah-alarm') == 1 && part('k-2750').fill > 0.8",
      "sometime": true
    },
    {
      "says": "the high-high trip closes XV-2750 and the feed stops",
      "check": "fired('hh-trip') == 1 && part('xv-2750').out < 0.001",
      "sometime": true
    },
    {
      "says": "the column is never filled past the trip level",
      "check": "part('k-2750').fill < 0.95"
    },
    {
      "says": "XV-2750 stays shut after the trip until reset by hand",
      "check": "part('xv-2750').out < 0.001 && part('k-2750').in < 0.001",
      "from": 12,
      "to": 23
    }
  ]
}
