      "at": [9, 1],
      "behaviour": {
        "role": "gate",
        "capacity": 100,
        "open": 1
      },
      "labelSide": "below",
      "tag": "HV-502A",
      "class": "GateValve"
    },
    {
      "id": "hv501b",
