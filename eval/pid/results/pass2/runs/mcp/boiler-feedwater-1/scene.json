          "below": 0.6,
          "until": 0.7
        }
      },
      "tag": "V-502",
      "class": "Vessel"
    },
    {
      "id": "steam",
      "kind": "factory",
      "label": "Steam to users",
      "at": [14, 2],
      "behaviour": {
        "role": "sink",
        "demand": "50 + 30 * shift(hour)"
      }
    },
    {
      "id": "mccA",
      "kind": "grid",
      "label": "Supply to P-501A",
      "at": [7, 0],
      "behaviour": {
        "role": "source",
        "output": "on('p501a') ? 50 : 0"
      }
    },
    {
      "id": "mccB",
      "kind": "grid",
      "label": "Supply to P-501B",
      "at": [7, 2],
      "behaviour": {
        "role": "source",
        "output": "on('p501a') ? 0 : 50"
      }
    }
