      "behaviour": {
        "role": "converter",
        "output": "water",
        "recipe": {
          "electric": 0.25,
          "water": 1
        },
        "capacity": 90
      },
      "labelSide": "below",
      "tag": "P-501B",
      "class": "CentrifugalPump"
    },
    {
      "id": "nrv501b",
      "kind": "valve",
      "label": "Check valve",
      "at": [8, 3],
      "behaviour": {
        "role": "gate",
        "capacity": 100,
        "open": 1
      },
      "labelSide": "above",
      "tag": "CV-501B",
