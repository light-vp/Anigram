      "id": "makeup",
      "kind": "river",
      "label": "Make-up water",
      "at": [0, 2],
      "behaviour": {
        "role": "source",
        "output": 100
      }
    },
    {
      "id": "lv501",
      "kind": "valve",
      "label": "Make-up level control",
      "at": [2, 2],
      "behaviour": {
        "role": "gate",
        "capacity": 100,
        "open": "clamp((0.85 - prev('d501').fill) / 0.1, 0, 1)"
      },
      "tag": "LV-501",
      "class": "ControlValve"
    },
    {
      "id": "d501",
      "kind": "reservoir",
      "label": "Deaerator",
