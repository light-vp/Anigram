    {
      "id": "lv502",
      "kind": "valve",
      "label": "Feed control valve",
      "at": [11, 2],
      "behaviour": {
        "role": "gate",
        "capacity": 100,
        "open": "clamp(0.9 + (0.6 - prev('v502').fill) * 4, 0, 1)"
      },
      "tag": "LV-502",
      "class": "ControlValve"
    },
    {
      "id": "v502",
      "kind": "reservoir",
      "label": "Steam drum",
      "at": [13, 2],
      "behaviour": {
        "role": "storage",
        "capacity": 40,
        "start": 0.6,
