  "switches": [
    {
      "id": "p501a",
      "label": "P-501A running",
      "on": true
    }
  ],
  "captions": [
    {
      "from": 6,
      "to": 11,
      "text": "P-501A feeds the drum; LV-502 holds drum level, LV-501 holds deaerator level."
    },
    {
      "from": 11,
      "to": 24,
      "text": "P-501A has tripped; P-501B carries the feed and the drum level holds."
    }
  ],
  "events": [
    {
      "id": "trip",
      "says": "P-501A trips on the day shift; P-501B, the standby, takes over the feed.",
      "when": "hour >= 11",
      "then": [
        {
          "switch": "p501a",
          "on": false
        }
      ],
      "at": "p501a",
      "once": true
    }
  ],
  "expect": [
    {
      "says": "before the trip P-501A is the duty pump and P-501B stands by",
      "check": "part('p501a').out > 0 && part('p501b').out == 0",
      "at": 8
    },
    {
      "says": "after the trip P-501A is stopped and P-501B delivers the feed",
      "check": "part('p501a').out == 0 && part('p501b').out > 0",
      "at": 14
    },
    {
      "says": "the steam drum never runs dry",
      "check": "part('v502').fill > 0.15"
    },
    {
      "says": "the deaerator never overflows",
      "check": "part('d501').fill < 0.95"
    },
    {
      "says": "the boiler gets the steam it asks for",
      "check": "part('steam').in >= 0.999 * part('steam').demand"
    }
  ]
}
