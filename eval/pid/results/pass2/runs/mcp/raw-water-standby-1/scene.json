      "high": 90
    },
    {
      "tag": "LIC-1601",
      "at": [2, 1],
      "measures": "LT-1601",
      "drives": "lv",
      "mounting": "dcs"
    },
    {
      "tag": "LSHH-1602",
      "at": [4, 3],
      "measures": "tank",
      "mounting": "panel",
      "high": 95
    }
  ],
  "switches": [
    {
      "id": "dutyA",
      "label": "P-1601A running",
      "on": true
    },
    {
      "id": "standbyB",
      "label": "P-1601B running",
      "on": false
    }
  ],
  "captions": [
    {
      "from": 6,
      "to": 10,
      "text": "P-1601A pumps to the plant while LV-1601 holds T-1601 level."
    },
    {
      "from": 10,
      "to": 12,
      "text": "P-1601A trips; P-1601B starts and LV-1601 / LSHH-1602 keep the tank from overflowing."
    }
  ],
  "events": [
    {
      "id": "trip",
      "says": "Mid-morning the duty pump P-1601A trips.",
      "when": "hour >= 10",
      "then": [
        {
          "switch": "dutyA",
          "on": false
        }
      ],
      "at": "pa",
      "once": true
    },
    {
      "id": "standby",
      "says": "The standby pump P-1601B starts on the trip.",
      "when": "fired('trip')",
      "then": [
        {
          "switch": "standbyB",
          "on": true
        }
      ],
      "after": 0.1,
      "at": "pb"
    }
  ],
  "expect": [
    {
      "says": "before the trip the duty pump delivers and the standby is idle",
      "check": "part('pa').out > 70 && part('pb').out < 0.1",
      "from": 7,
      "to": 9
    },
    {
      "says": "after the trip the standby carries the plant",
      "check": "part('pb').out > 70 && part('pa').out < 0.1",
      "from": 12,
      "to": 23
    },
    {
      "says": "the plant is never short",
      "check": "part('plant').in >= 0.999 * part('plant').demand"
    },
    {
      "says": "the tank never overflows",
      "check": "part('tank').fill < 0.97"
    },
    {
      "says": "the tank never runs dry",
      "check": "part('tank').fill > 0.1"
    }
  ]
}
