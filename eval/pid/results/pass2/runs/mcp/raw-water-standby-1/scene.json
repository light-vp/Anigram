{
  "anigram": 1,
  "id": "raw-water-transfer",
  "title": "Raw water transfer",
  "subtitle": "River intake fills T-1601; duty pump P-1601A trips and standby P-1601B takes over",
  "sheet": "PID-1601",
  "size": [13, 5],
  "units": {
    "water": {
      "rate": "m³/h",
      "amount": "m³"
