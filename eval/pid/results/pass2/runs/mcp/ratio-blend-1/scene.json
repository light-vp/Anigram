{
  "anigram": 1,
  "id": "blend-skid",
  "title": "In-line Blending Skid",
  "subtitle": "Additive follows the wild base stock flow at 5%",
  "sheet": "PID-1200",
  "size": [8, 4],
  "units": {
    "water": {
      "rate": "m³/h",
      "amount": "m³"
    },
    "electric": {
      "rate": "kW",
      "amount": "kWh"
    }
  },
  "scale": {
    "water": 120,
    "electric": 30
  },
  "parts": [
    {
      "id": "base",
      "kind": "river",
      "label": "Base stock from off sheet",
      "at": [0, 1],
      "behaviour": {
        "role": "source",
        "output": "50 + 60 * shift(hour) + 10 * sin(hour)"
      },
      "labelSide": "below",
      "tag": "OPC-1201",
      "class": "OffPageConnector"
    },
    {
      "id": "power",
      "kind": "grid",
      "label": "Electricity",
      "at": [7, 3],
      "behaviour": {
        "role": "source",
        "output": 20
      }
    },
    {
      "id": "t1202",
      "kind": "reservoir",
      "label": "Additive tank",
      "at": [0, 3],
      "behaviour": {
        "role": "source",
        "output": 10
      },
      "tag": "T-1202",
      "class": "Tank"
    },
    {
      "id": "p1202",
      "kind": "pump",
      "label": "Additive pump",
      "at": [2, 3],
      "behaviour": {
        "role": "converter",
        "output": "water",
        "recipe": {
          "electric": 0.05,
          "water": 1
        },
        "capacity": 10
      },
      "labelSide": "below",
      "tag": "P-1202",
      "class": "CentrifugalPump"
    },
    {
      "id": "fv",
      "kind": "valve",
      "label": "Additive control valve",
      "at": [4, 3],
      "behaviour": {
        "role": "gate",
        "capacity": 10,
        "open": "clamp(0.05 * (50 + 60 * shift(hour) + 10 * sin(hour)) / 10, 0, 1)"
      },
      "tag": "FV-1202",
      "class": "ControlValve"
    },
    {
      "id": "m1201",
      "kind": "manifold",
      "label": "Static mixer",
      "at": [4, 1],
      "behaviour": {
        "role": "bus"
      },
      "labelSide": "above",
      "tag": "M-1201",
      "class": "Junction"
    },
    {
      "id": "t1203",
      "kind": "reservoir",
      "label": "Blend tank",
      "at": [6, 1],
      "behaviour": {
        "role": "storage",
        "capacity": 800,
        "start": 0.3,
        "maxIn": 200,
        "maxOut": 150
      },
      "tag": "T-1203",
      "class": "Tank"
    },
    {
      "id": "out",
      "kind": "factory",
      "label": "Blend to dispatch",
      "at": [7, 1],
      "behaviour": {
        "role": "sink",
        "demand": 70
      },
      "tag": "OPC-1203",
      "class": "OffPageConnector"
    }
  ],
  "links": [
    {
      "from": "base",
      "to": "m1201",
      "domain": "water",
      "via": [],
      "tag": "100-BS-1201"
    },
    {
      "from": "power",
      "to": "p1202",
      "domain": "electric"
    },
    {
      "from": "t1202",
      "to": "p1202",
      "domain": "water",
      "via": [],
      "tag": "25-ADD-1202"
    },
    {
      "from": "p1202",
      "to": "fv",
      "domain": "water",
      "via": [],
      "tag": "25-ADD-1203"
    },
    {
      "from": "fv",
      "to": "m1201",
      "domain": "water",
      "via": [],
      "tag": "25-ADD-1204"
    },
    {
      "from": "m1201",
      "to": "t1203",
      "domain": "water",
      "tag": "100-BL-1205"
    },
    {
      "from": "t1203",
      "to": "out",
      "domain": "water",
      "tag": "100-BL-1206"
    }
  ],
  "clock": {
    "start": 0,
    "rate": 1
  },
  "drawing": "pid",
  "titleBlock": {
    "owner": "Blending Plant",
    "project": "In-line blending skid",
    "drawnBy": "VP",
    "issued": "2026-10-17",
    "revision": "A",
    "status": "draft"
  },
  "instruments": [
    {
      "tag": "FT-1201",
      "at": [0, 0],
      "measures": "base"
    },
    {
      "tag": "FFIC-1202",
      "at": [5, 2],
      "measures": "FT-1202",
      "drives": "fv",
      "mounting": "dcs"
    },
    {
      "tag": "FT-1202",
      "at": [3, 2],
      "measures": "fv"
    }
  ],
  "captions": [
    {
      "from": 0,
      "to": 24,
      "text": "Additive flow tracks the wild base stock flow at 5%."
    }
  ],
  "expect": [
    {
      "says": "additive flow is 5% of base stock flow all day",
      "check": "abs(part('fv').out - 0.05 * part('base').out) < 0.02"
    },
    {
      "says": "base stock swings with the day shift",
      "check": "part('base').out > 90",
      "at": 13
    },
    {
      "says": "base stock is lower overnight",
      "check": "part('base').out < 70",
      "at": 2
    },
    {
      "says": "additive peaks at midday around 5 to 6",
      "check": "part('fv').out > 4.5",
      "at": 13
    },
    {
      "says": "the blend reaches the blend tank",
      "check": "part('t1203').in > 0",
      "at": 13
    }
  ]
}
