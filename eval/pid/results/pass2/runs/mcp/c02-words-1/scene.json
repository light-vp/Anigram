  "expect": [
    {
      "says": "the column holds a steady operating pressure below the high-pressure trip",
      "check": "part('k').effort > 1 && part('k').effort < 4"
    },
    {
      "says": "the bottoms leave through N2 to W 2765",
      "check": "part('w2765').in >= 0.999 * part('w2765').demand"
    },
    {
      "says": "the N3 tee carries flow on off the sheet",
      "check": "part('n3off').in >= 0.999 * part('n3off').demand"
    },
    {
      "says": "the dead-end tappings and blinded leg carry no flow",
      "check": "part('v3end').in < 0.001 && part('p3e').in < 0.001 && part('p4e').in < 0.001"
    }
  ]
