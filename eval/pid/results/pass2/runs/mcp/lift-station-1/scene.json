{
  "anigram": 1,
  "id": "lift-station",
  "title": "Wastewater Lift Station",
  "subtitle": "Wet well WW-1501 with duty/assist submersible pumps to the rising main",
  "sheet": "PID-1501",
  "size": [10, 5],
  "units": {
    "water": {
      "rate": "m³/h",
      "amount": "m³"
    },
    "electric": {
      "rate": "kW",
      "amount": "kWh"
    }
  },
  "scale": {
    "water": 250,
    "electric": 30
  },
  "parts": [
    {
      "id": "inflow",
      "kind": "river",
      "label": "Gravity sewer inflow",
      "at": [0, 2],
      "behaviour": {
        "role": "source",
        "output": "15 + 200 * rain(hour)"
      }
    },
    {
      "id": "ww",
      "kind": "reservoir",
      "label": "Wet well",
      "at": [2, 2],
      "behaviour": {
        "role": "storage",
        "capacity": 80,
        "start": 0.3,
        "maxIn": 300,
        "maxOut": 300
      },
      "labelSide": "below",
      "tag": "WW-1501",
      "class": "Tank"
    },
    {
      "id": "pa",
      "kind": "pump",
      "label": "Submersible pump A",
      "at": [4, 1],
      "behaviour": {
        "role": "converter",
        "output": "water",
        "recipe": {
          "electric": 0.15,
          "water": 1
        },
        "capacity": 120
      },
      "tag": "P-1501A",
      "class": "CentrifugalPump"
    },
    {
      "id": "pb",
      "kind": "pump",
      "label": "Submersible pump B",
      "at": [4, 3],
      "behaviour": {
        "role": "converter",
        "output": "water",
        "recipe": {
          "electric": 0.15,
          "water": 1
        },
        "capacity": 120
      },
      "tag": "P-1501B",
      "class": "CentrifugalPump"
    },
    {
      "id": "cva",
      "kind": "valve",
      "label": "Check valve A",
      "at": [5, 1],
      "behaviour": {
        "role": "gate",
        "capacity": 150,
        "open": "on('runA')"
      },
      "tag": "XV-1501A",
      "class": "CheckValve"
    },
    {
      "id": "cvb",
      "kind": "valve",
      "label": "Check valve B",
      "at": [5, 3],
      "behaviour": {
        "role": "gate",
        "capacity": 150,
        "open": "on('runB')"
      },
      "tag": "XV-1501B",
      "class": "CheckValve"
    },
    {
      "id": "iva",
      "kind": "valve",
      "label": "Isolating valve A",
      "at": [6, 1],
      "behaviour": {
        "role": "gate",
        "capacity": 150,
        "open": 1
      },
      "tag": "V-1501A",
      "class": "GateValve"
    },
    {
      "id": "ivb",
      "kind": "valve",
      "label": "Isolating valve B",
      "at": [6, 3],
      "behaviour": {
        "role": "gate",
        "capacity": 150,
        "open": 1
      },
      "tag": "V-1501B",
      "class": "GateValve"
    },
    {
      "id": "hdr",
      "kind": "manifold",
      "label": "Common header",
      "at": [7, 2],
      "behaviour": {
        "role": "bus"
      },
      "tag": "J-1501",
      "class": "Junction"
    },
    {
      "id": "main",
      "kind": "river",
      "label": "To rising main",
      "at": [9, 2],
      "behaviour": {
        "role": "sink",
        "demand": "120 * on('runA') + 120 * on('runB')"
      }
    },
    {
      "id": "power",
      "kind": "grid",
      "label": "MCC supply",
      "at": [3, 0],
      "behaviour": {
        "role": "source",
        "output": 60,
        "dispatchable": true
      }
    }
  ],
  "links": [
    {
      "from": "inflow",
      "to": "ww",
      "domain": "water",
      "tag": "300-WW-001"
    },
    {
      "from": "ww",
      "to": "pa",
      "domain": "water",
      "via": [
        [3, 2],
        [3, 1]
      ],
      "tag": "150-WW-002"
    },
    {
      "from": "ww",
      "to": "pb",
      "domain": "water",
      "via": [
        [3, 2],
        [3, 3]
      ],
      "tag": "150-WW-003"
    },
    {
      "from": "pa",
      "to": "cva",
      "domain": "water",
      "tag": "150-WW-004"
    },
    {
      "from": "pb",
      "to": "cvb",
      "domain": "water",
      "tag": "150-WW-005"
    },
    {
      "from": "cva",
      "to": "iva",
      "domain": "water",
      "tag": "150-WW-006"
    },
    {
      "from": "cvb",
      "to": "ivb",
      "domain": "water",
      "tag": "150-WW-007"
    },
    {
      "from": "iva",
      "to": "hdr",
      "domain": "water",
      "via": [[7, 1]],
      "tag": "150-WW-008"
    },
    {
      "from": "ivb",
      "to": "hdr",
      "domain": "water",
      "via": [[7, 3]],
      "tag": "150-WW-009"
    },
    {
      "from": "hdr",
      "to": "main",
      "domain": "water",
      "tag": "250-WW-010"
    },
    {
      "from": "power",
      "to": "pa",
      "domain": "electric"
    },
    {
      "from": "power",
      "to": "pb",
      "domain": "electric"
    }
  ],
  "clock": {
    "start": 0,
    "rate": 1
  },
  "drawing": "pid",
  "titleBlock": {
    "owner": "Municipal Wastewater Utility",
    "project": "Lift Station 15",
    "drawnBy": "VP",
    "issued": "2026-10-17",
    "revision": "A",
    "status": "for review"
  },
  "instruments": [
    {
      "tag": "LT-1501",
      "at": [2, 1],
      "measures": "ww",
      "low": 15,
      "high": 90
    },
    {
      "tag": "LI-1501",
      "at": [3, 1],
      "measures": "LT-1501",
      "mounting": "plc"
    },
    {
      "tag": "LAHH-1501",
      "at": [1, 1],
      "measures": "LT-1501",
      "reads": "part('ww').fill * 100 > 90 ? 1 : 0",
      "mounting": "plc"
    }
  ],
  "switches": [
    {
      "id": "runA",
      "label": "P-1501A running",
      "on": false
    },
    {
      "id": "runB",
      "label": "P-1501B running",
      "on": false
    }
  ],
  "captions": [
    {
      "from": 0,
      "to": 6,
      "text": "Quiet hours: the pumps cycle on and off."
    },
    {
      "from": 13,
      "to": 19,
      "text": "Afternoon storm: both pumps run."
    }
  ],
  "events": [
    {
      "id": "leadStart",
      "says": "Wet well reaches the start level: PLC starts lead pump P-1501A.",
      "when": "part('ww').fill > 0.5",
      "then": [
        {
          "switch": "runA",
          "on": true
        }
      ],
      "at": "pa"
    },
    {
      "id": "stop",
      "says": "Wet well drawn down to the stop level: PLC stops the pumps.",
      "when": "part('ww').fill < 0.15",
      "then": [
        {
          "switch": "runA",
          "on": false
        },
        {
          "switch": "runB",
          "on": false
        }
      ],
      "at": "ww"
    },
    {
      "id": "lagStart",
      "says": "High level in the storm: PLC starts lag pump P-1501B.",
      "when": "part('ww').fill > 0.7",
      "then": [
        {
          "switch": "runB",
          "on": true
        }
      ],
      "at": "pb"
    }
  ],
  "expect": [
    {
      "says": "the wet well never overflows",
      "check": "part('ww').fill < 0.95"
    },
    {
      "says": "in the afternoon storm both pumps run",
      "check": "part('pa').out > 1 && part('pb').out > 1",
      "at": 15
    },
    {
      "says": "overnight the pumps stop at times",
      "check": "part('pa').out < 0.01",
      "from": 0,
      "to": 5,
      "sometime": true
    }
  ]
}
