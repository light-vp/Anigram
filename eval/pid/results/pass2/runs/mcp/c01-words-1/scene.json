  "expect": [
    {
      "says": "HV-4750.01 is open under HS-4750.01 and the feed reaches T-4750",
      "check": "part('hv').in > 0.5"
    },
    {
      "says": "SV-104.01 stays shut: discharge pressure is below its 6 barg set point",
      "check": "part('sv').out < 0.01"
    },
    {
      "says": "The drain valve is shut and nothing goes to drain",
      "check": "part('drain').in < 0.01"
    },
    {
      "says": "Product leaves the sheet at its demand",
      "check": "part('prod').in >= 0.99 * part('prod').demand"
    },
    {
      "says": "P-4712 discharge pressure stays under the 6 barg relief set point",
      "check": "part('p4712').effort < 6"
    }
  ]
