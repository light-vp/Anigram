      "at": [4, 1],
      "behaviour": {
        "role": "gate",
        "capacity": 400,
        "open": 1
      },
      "tag": "HV-801",
      "class": "GateValve"
    },
    {
      "id": "hv-802",
      "kind": "valve",
      "label": "Outlet isolation",
      "at": [4, 3],
      "behaviour": {
        "role": "gate",
        "capacity": 400,
        "open": 1
      },
      "tag": "HV-802",
      "class": "GateValve"
    },
    {
      "id": "hv-803",
      "kind": "valve",
      "label": "Outlet isolation",
      "at": [4, 5],
