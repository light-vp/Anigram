  "switches": [
    {
      "id": "xv801",
      "label": "XV-801 open",
      "on": true
    },
    {
      "id": "xv802",
      "label": "XV-802 open",
      "on": false
    },
    {
      "id": "xv803",
      "label": "XV-803 open",
      "on": false
    }
  ],
  "captions": [
    {
      "from": 6,
      "to": 24,
      "text": "Receipt fills TK-801 first, then TK-802, then TK-803."
    }
  ],
  "events": [
    {
      "id": "hh811",
      "says": "TK-801 reaches high-high: LSHH-811 closes XV-801.",
      "when": "part('tk-801').fill > 0.94",
      "then": [
        {
          "switch": "xv801",
          "on": false
        }
      ],
      "at": "tk-801"
    },
    {
      "id": "carry802",
      "says": "The receipt carries on into TK-802 through XV-802.",
      "when": "fired('hh811')",
      "then": [
        {
          "switch": "xv802",
          "on": true
        }
      ],
      "at": "xv-802"
    },
    {
      "id": "hh812",
      "says": "TK-802 reaches high-high: LSHH-812 closes XV-802.",
      "when": "part('tk-802').fill > 0.94",
      "then": [
        {
          "switch": "xv802",
          "on": false
        }
      ],
      "at": "tk-802"
    },
    {
      "id": "carry803",
      "says": "The receipt moves on to TK-803 through XV-803.",
      "when": "fired('hh812')",
      "then": [
        {
          "switch": "xv803",
          "on": true
        }
      ],
      "at": "xv-803"
    },
    {
      "id": "hh813",
      "says": "TK-803 reaches high-high: LSHH-813 closes XV-803.",
      "when": "part('tk-803').fill > 0.94",
      "then": [
        {
          "switch": "xv803",
          "on": false
        }
      ],
      "at": "tk-803"
    }
  ],
  "expect": [
    {
      "says": "TK-801 fills first and its high-high closes XV-801",
      "check": "part('tk-801').fill > 0.9 && part('xv-801').out < 0.01",
      "sometime": true
    },
    {
      "says": "the receipt carries on into TK-802",
      "check": "part('tk-802').in > 100 && part('xv-801').out < 0.01",
      "sometime": true
    },
    {
      "says": "TK-802 is not filled while TK-801 is still taking receipt",
      "check": "part('xv-801').out < 0.01 || part('tk-802').in < 0.01"
    },
    {
      "says": "no tank ever overflows",
      "check": "part('tk-801').fill < 0.98 && part('tk-802').fill < 0.98 && part('tk-803').fill < 0.98"
    },
    {
      "says": "the loading rack is served",
      "check": "part('rack').in >= 0.999 * part('rack').demand"
    }
  ]
}
