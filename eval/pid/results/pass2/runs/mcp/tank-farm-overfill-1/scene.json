      "label": "Tank 803",
      "at": [3, 5],
      "behaviour": {
        "role": "storage",
        "capacity": 5000,
        "start": 0.2,
        "maxIn": 400,
        "maxOut": 400
      },
      "tag": "TK-803",
      "class": "Tank"
    },
    {
      "id": "hv-801",
      "kind": "valve",
