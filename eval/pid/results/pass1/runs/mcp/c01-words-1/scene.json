  "expect": [
    {
      "says": "HS-4750.01 holds HV-4750.01 open so the feed on 47121 reaches T-4750",
      "check": "part('hv').in > 1"
    },
    {
      "says": "product leaves the sheet on header 47126 at its full demand",
      "check": "part('prod').in >= 0.999 * part('prod').demand"
    },
    {
      "says": "P-4712 discharge pressure stays under the 6 barg set point of SV-104.01",
      "check": "part('p2').effort < 6"
    },
    {
      "says": "SV-104.01 stays shut in normal running, so nothing returns on 47125",
      "check": "part('sv').out < 0.001"
    },
    {
      "says": "the drain valve is shut and nothing drains",
      "check": "part('drain').in < 0.001"
    },
    {
      "says": "T-4750 never runs dry",
      "check": "part('t').fill > 0.1"
    }
  ]
