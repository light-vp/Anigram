      },
      "tag": "V-1601",
      "class": "GateValve"
    },
    {
      "id": "pa",
      "kind": "pump",
      "label": "Transfer pump (duty)",
      "at": [8, 0],
      "behaviour": {
        "role": "converter",
        "output": "water",
        "recipe": {
          "electric": 0.2,
          "water": 1
