{
  "anigram": 1,
  "id": "raw-water-transfer",
  "title": "Raw water transfer",
  "subtitle": "Intake fills T-1601; duty/standby pumps P-1601A/B send it to treatment",
  "sheet": "PID-1601",
  "size": [14, 5],
  "units": {
    "water": {
      "rate": "m³/h",
      "amount": "m³"
    },
    "electric": {
      "rate": "kW",
      "amount": "kWh"
    }
  },
  "scale": {
    "water": 120,
    "electric": 50
  },
  "parts": [
    {
      "id": "feed",
      "kind": "river",
      "label": "Raw water from river intake",
      "at": [0.5, 2],
      "behaviour": {
        "role": "source",
        "output": 120
      },
      "labelSide": "below"
    },
    {
      "id": "power",
      "kind": "grid",
      "label": "Electricity",
      "at": [9, 2],
      "behaviour": {
        "role": "source",
        "output": 100,
        "dispatchable": true
      }
    },
    {
      "id": "mccA",
      "kind": "breaker",
      "label": "Motor starter A",
      "at": [8, 1],
      "behaviour": {
        "role": "gate",
        "capacity": 100,
        "open": "on('tripA') ? 0 : 1"
      }
    },
    {
      "id": "mccB",
      "kind": "breaker",
      "label": "Motor starter B",
      "at": [8, 3],
      "behaviour": {
        "role": "gate",
        "capacity": 100,
        "open": "on('runB') ? 1 : 0"
      }
    },
    {
      "id": "lv",
      "kind": "valve",
      "label": "Intake control valve",
      "at": [2, 2],
      "behaviour": {
        "role": "gate",
        "capacity": 150,
        "open": "clamp((0.8 - prev('tank').fill) / 0.1, 0, 1) * (prev('tank').fill < 0.95 ? 1 : 0)"
      },
      "tag": "LV-1601",
      "class": "ControlValve"
    },
    {
      "id": "tank",
      "kind": "reservoir",
      "label": "Raw water tank",
      "at": [4, 2],
      "behaviour": {
        "role": "storage",
        "capacity": 400,
        "start": 0.6,
        "maxIn": 150,
        "maxOut": 150
      },
      "tag": "T-1601",
      "class": "Tank"
    },
    {
      "id": "j1",
      "kind": "manifold",
      "label": "Suction header",
      "at": [6, 2],
      "behaviour": {
        "role": "bus"
      },
      "class": "Junction"
    },
    {
      "id": "sva",
      "kind": "valve",
