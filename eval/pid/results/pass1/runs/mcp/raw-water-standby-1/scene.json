  "instruments": [
    {
      "tag": "LT-1601",
      "at": [4, 1],
      "measures": "tank",
      "low": 20,
      "high": 90
    },
    {
      "tag": "LIC-1601",
      "at": [2, 1],
      "measures": "LT-1601",
      "drives": "lv",
      "mounting": "dcs"
    },
    {
      "tag": "LSHH-1602",
      "at": [5, 1],
      "measures": "tank",
      "mounting": "plc",
      "high": 95
    }
  ],
  "switches": [
    {
      "id": "tripA",
      "label": "P-1601A tripped",
      "on": false
    },
    {
      "id": "runB",
      "label": "P-1601B running",
      "on": false
    }
  ],
  "captions": [
    {
      "from": 6,
      "to": 10,
      "text": "P-1601A pumps tank T-1601 to treatment; LV-1601 holds the level."
    },
    {
      "from": 10,
      "to": 12,
      "text": "P-1601A trips; P-1601B starts and the tank never overflows."
    }
  ],
  "events": [
    {
      "id": "trip",
      "says": "Mid-morning the duty pump P-1601A trips.",
      "when": "hour >= 10",
      "then": [
        {
          "switch": "tripA",
          "on": true
        }
      ],
      "at": "pa",
      "once": true
    },
    {
      "id": "standby",
      "says": "Loss of duty flow starts standby pump P-1601B.",
      "when": "on('tripA')",
      "then": [
        {
          "switch": "runB",
          "on": true
        }
      ],
      "after": 0.1,
      "at": "pb",
      "once": true
    }
  ],
  "expect": [
    {
      "says": "before the trip the duty pump P-1601A feeds the plant",
      "check": "part('pa').out > 70 && part('pb').out < 1",
      "at": 8
    },
    {
      "says": "after the trip the standby P-1601B carries the plant",
      "check": "part('pa').out < 1 && part('pb').out > 70",
      "at": 12
    },
    {
      "says": "the plant is supplied after the standby takes over",
      "check": "part('plant').in >= 0.99 * part('plant').demand",
      "from": 12,
      "to": 16
    },
    {
      "says": "the tank never overflows (stays below the LSHH-1602 trip)",
      "check": "part('tank').fill < 0.95"
    },
    {
      "says": "the tank never runs dry",
      "check": "part('tank').fill > 0.1"
    }
  ]
}
