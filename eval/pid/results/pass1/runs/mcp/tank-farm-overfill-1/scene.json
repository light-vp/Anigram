  "instruments": [
    {
      "tag": "LT/LAH-801",
      "at": [4, 0],
      "measures": "tk801",
      "high": 90
    },
    {
      "tag": "LT/LAH-802",
      "at": [4, 3],
      "measures": "tk802",
      "high": 90
    },
    {
      "tag": "LT/LAH-803",
      "at": [4, 6],
      "measures": "tk803",
      "high": 90
    },
    {
      "tag": "LSHH-811",
      "at": [2, 0],
      "measures": "tk801",
      "reads": "part('tk801').fill > 0.95 ? 1 : 0",
      "drives": "xv801"
    },
    {
      "tag": "LSHH-812",
      "at": [2, 3],
      "measures": "tk802",
      "reads": "part('tk802').fill > 0.95 ? 1 : 0",
      "drives": "xv802"
    },
    {
      "tag": "LSHH-813",
      "at": [2, 6],
      "measures": "tk803",
      "reads": "part('tk803').fill > 0.95 ? 1 : 0",
      "drives": "xv803"
    }
  ],
  "switches": [
    {
      "id": "xv801",
      "label": "XV-801 open",
      "on": true
    },
    {
      "id": "xv802",
      "label": "XV-802 open",
      "on": false
    },
    {
      "id": "xv803",
      "label": "XV-803 open",
      "on": false
    }
  ],
  "captions": [
    {
      "from": 6,
      "to": 10,
      "text": "Receipt arrives from the pipeline and fills TK-801 through XV-801."
    },
    {
      "from": 10,
      "to": 18,
      "text": "TK-801 is full and isolated; the receipt carries on into TK-802."
    },
    {
      "from": 18,
      "to": 24,
      "text": "Receipt ends; the loading pump keeps drawing from the tanks. No tank overflows."
    }
  ],
  "events": [
    {
      "id": "hh801",
      "says": "LSHH-811 trips on high-high in TK-801 and closes XV-801.",
      "when": "part('tk801').fill > 0.95",
      "then": [
        {
          "switch": "xv801",
          "on": false
        }
      ],
      "at": "tk801"
    },
    {
      "id": "next802",
      "says": "The receipt is lined up to TK-802 through XV-802.",
      "when": "fired('hh801')",
      "then": [
        {
          "switch": "xv802",
          "on": true
        }
      ],
      "at": "xv802"
    },
    {
      "id": "hh802",
      "says": "LSHH-812 trips on high-high in TK-802 and closes XV-802.",
      "when": "part('tk802').fill > 0.95",
      "then": [
        {
          "switch": "xv802",
          "on": false
        }
      ],
      "at": "tk802"
    },
    {
      "id": "next803",
      "says": "The receipt carries on into TK-803 through XV-803.",
      "when": "fired('hh802')",
      "then": [
        {
          "switch": "xv803",
          "on": true
        }
      ],
      "at": "xv803"
    },
    {
      "id": "hh803",
      "says": "LSHH-813 trips on high-high in TK-803 and closes XV-803.",
      "when": "part('tk803').fill > 0.95",
      "then": [
        {
          "switch": "xv803",
          "on": false
        }
      ],
      "at": "tk803"
    }
  ],
  "expect": [
    {
      "says": "TK-801 fills first: its high-high has tripped and XV-801 is shut",
      "check": "since('hh801') < 24 && on('xv801') == 0 && part('xv801').out < 0.001 && part('tk801').fill > 0.8",
      "at": 14
    },
    {
      "says": "before that, XV-801 is open and the receipt goes only to TK-801",
      "check": "part('xv801').out > 50 && part('xv802').out < 0.001",
      "at": 7
    },
    {
      "says": "after TK-801 is full the receipt carries on into TK-802",
      "check": "part('xv802').out > 50 && part('tk802').fill > 0.3",
      "at": 14
    },
    {
      "says": "TK-802 is not the first to fill",
      "check": "part('tk802').fill < part('tk801').fill",
      "at": 14
    },
    {
      "says": "no tank ever overflows",
      "check": "part('tk801').fill < 0.99 && part('tk802').fill < 0.99 && part('tk803').fill < 0.99"
    },
    {
      "says": "the loading rack is served through the day",
      "check": "part('rack').in >= 0.999 * part('rack').demand"
    }
  ]
}
