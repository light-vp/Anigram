{
  "anigram": 1,
  "id": "k-2750-feed-trip",
  "title": "Packed column K-2750",
  "subtitle": "HAZOP action: feed shutdown valve XV-2750, high level alarm and independent high-high trip",
  "sheet": "DEXPI Example C02",
  "size": [5, 5],
  "units": {
    "water": {
      "rate": "m³/h",
      "amount": "m³"
    },
    "heat": {
      "rate": "kW",
      "amount": "kWh"
    }
  },
  "scale": {
    "water": 120,
    "heat": 60
  },
  "parts": [
    {
      "id": "k-2750",
      "kind": "hottank",
      "label": "Column",
      "at": [2, 1],
      "behaviour": {
        "role": "storage",
        "capacity": 240,
        "start": 0.5,
        "maxIn": 120,
        "maxOut": 120
      },
      "note": "Process column ProcessColumn-1, 500 x 14000 mm, 1.4571, pe = 6/-1 bar, 150 °C. Carries packed bed KX 2750 (fixed bed, 600 mm). Sump level is the column fill.",
      "tag": "K-2750",
      "class": "Vessel"
    },
    {
      "id": "feed-in",
      "kind": "well",
      "label": "Feed from off sheet",
      "at": [0, 1],
      "behaviour": {
        "role": "source",
        "output": 90
      },
      "note": "HAZOP action: new feed line into the column from off the sheet.",
      "labelSide": "below",
      "class": "OffPageConnector"
    },
    {
      "id": "xv-2750",
      "kind": "valve",
      "label": "Feed shutdown valve",
      "at": [1, 1],
      "behaviour": {
        "role": "gate",
        "capacity": 120,
        "open": "on('xv-2750') ? 1 : 0"
      },
      "note": "Closed by the independent high-high level trip LSHH-2750.",
      "labelSide": "above",
      "toggles": "xv-2750",
      "tag": "XV-2750",
      "class": "BallValve"
    },
    {
      "id": "off-page-connector",
      "kind": "tap",
      "label": "To elsewhere",
      "at": [3, 3],
      "behaviour": {
        "role": "sink",
        "demand": "(prev('k-2750').fill > 0.15 ? 20 : 0) * knob('throughput')"
      },
      "note": "Flow out pipe off page connector in the DEXPI file (FlowOutPipeOffPageConnector-1).",
      "class": "OffPageConnector"
    },
    {
      "id": "junction",
      "kind": "manifold",
      "label": "Pipe tee",
      "at": [3, 2],
      "behaviour": {
        "role": "bus"
      },
      "note": "Pipe tee in the DEXPI file (PipeTee-1).",
      "class": "Junction"
    },
    {
      "id": "off-page-connector-2",
      "kind": "tap",
      "label": "Out",
      "at": [4, 3],
      "behaviour": {
        "role": "sink",
        "demand": "(prev('k-2750').fill > 0.15 ? 40 : 0) * knob('throughput')"
      },
      "note": "Flow out pipe off page connector in the DEXPI file (open-1).",
      "class": "OffPageConnector"
    },
    {
      "id": "globe-valve",
      "kind": "valve",
      "label": "Operated valve",
      "at": [4, 2],
      "behaviour": {
        "role": "sink",
        "demand": "on('globe-valve') ? 15 : 0"
      },
      "note": "Operated valve in the DEXPI file (OperatedValve-1, H672B1V).",
      "toggles": "globe-valve",
      "class": "GlobeValve"
    },
    {
      "id": "globe-valve-2",
      "kind": "valve",
      "label": "Operated valve",
      "at": [3, 1],
      "behaviour": {
        "role": "sink",
        "demand": 0
      },
      "note": "Operated valve in the DEXPI file (OperatedValve-2).",
      "class": "GlobeValve"
    },
    {
      "id": "globe-valve-3",
      "kind": "valve",
      "label": "Operated valve",
      "at": [3, 4],
      "behaviour": {
        "role": "sink",
        "demand": 0
      },
      "note": "Operated valve in the DEXPI file (OperatedValve-3).",
      "class": "GlobeValve"
    }
  ],
  "links": [
    {
      "from": "feed-in",
      "to": "xv-2750",
