    }
  ],
  "knobs": [
    {
      "id": "throughput",
      "label": "throughput",
      "value": 1,
      "min": 0,
      "max": 1.5,
      "step": 0.05,
      "format": "{pct}%"
    }
  ],
  "switches": [
    {
      "id": "esv",
      "label": "ESV-3712 open (energised)",
      "on": true
    }
  ],
  "expect": [
    {
      "says": "with ESV-3712 open the flow reaches the off-page connector",
      "check": "part('opc').in >= 0.999 * part('opc').demand"
    },
    {
      "says": "the orifice and ball valve pass the same flow as the operated valve",
      "check": "part('ro').out >= 0.999 * part('ov').out && part('bv').out >= 0.999 * part('ov').out"
    }
  ]
