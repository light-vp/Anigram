      "tag": "50-P-002"
    },
    {
      "from": "r",
      "to": "product",
      "domain": "water",
      "tag": "50-P-003"
    },
    {
      "from": "r",
      "to": "rd",
      "domain": "water",
      "tag": "40-P-004"
    },
    {
      "from": "rd",
      "to": "psv",
      "domain": "water",
      "via": [[4, 0]],
      "tag": "40-P-005"
    },
    {
      "from": "psv",
      "to": "catch",
      "domain": "water",
      "tag": "40-P-006"
    },
    {
      "from": "cw",
      "to": "tv",
      "domain": "water",
      "tag": "50-CW-001"
    },
    {
      "from": "tv",
      "to": "jacket",
      "domain": "water",
      "via": [],
      "tag": "50-CW-002"
    },
    {
      "from": "jacket",
      "to": "cwr",
      "domain": "water",
      "via": [],
      "tag": "50-CW-003"
    }
  ],
  "clock": {
    "start": 6,
    "rate": 1
  },
  "drawing": "pid",
  "titleBlock": {
    "owner": "Process Engineering",
    "project": "Reactor R-1001 jacket cooling",
    "drawnBy": "VP",
    "issued": "2026-10-17",
    "revision": "A",
    "status": "draft"
  },
  "instruments": [
    {
      "tag": "FT-1001",
      "at": [1, 1],
      "measures": "fv"
    },
    {
      "tag": "FIC-1001",
      "at": [2, 1],
      "measures": "FT-1001",
      "drives": "fv",
      "mounting": "dcs"
    },
    {
      "tag": "LT-1001",
      "at": [3, 1],
      "measures": "r",
      "low": 20,
      "high": 85
    },
    {
      "tag": "TT-1001",
      "at": [5, 3],
      "measures": "r",
      "reads": "92 - 14 * part('tv').out / 12",
      "unit": "°C"
    },
    {
      "tag": "TIC-1001",
      "at": [3, 3],
      "measures": "TT-1001",
      "drives": "tv",
      "mounting": "dcs"
    }
  ],
  "expect": [
    {
      "says": "feed is held near 8 m³/h by FV-1001",
      "check": "part('fv').out > 7.9 && part('fv').out < 8.1"
    },
    {
      "says": "reactor level stays within its working band",
      "check": "part('r').fill > 0.2 && part('r').fill < 0.85"
    },
    {
      "says": "TIC-1001 opens TV-1001 wider in the afternoon exotherm than at night",
      "check": "part('tv').out > 8 && part('tv').out > 0",
      "at": 13
    },
    {
      "says": "cooling water is throttled back at night",
      "check": "part('tv').out < 6",
      "at": 3
    },
    {
      "says": "jacket return carries all the cooling water",
      "check": "part('cwr').in >= 0.999 * part('tv').out"
    },
    {
      "says": "the relief valve stays shut in normal operation",
      "check": "part('psv').out < 0.001 && part('catch').in < 0.001"
    }
  ]
}
