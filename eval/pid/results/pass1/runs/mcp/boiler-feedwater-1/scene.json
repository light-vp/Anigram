  "instruments": [
    {
      "tag": "LT-501",
      "at": [3, 1],
      "measures": "d501",
      "low": 25,
      "high": 90
    },
    {
      "tag": "LIC-501",
      "at": [1, 1],
      "measures": "LT-501",
      "drives": "lv501",
      "mounting": "dcs"
    },
    {
      "tag": "LT-502",
      "at": [12, 1],
      "measures": "v502",
      "low": 25,
      "high": 90
    },
    {
      "tag": "LIC-502",
      "at": [10, 1],
      "measures": "LT-502",
      "drives": "lv502",
      "mounting": "dcs"
    }
  ],
  "switches": [
    {
      "id": "pumpA",
      "label": "P-501A running",
      "on": true
    },
    {
      "id": "pumpB",
      "label": "P-501B running",
      "on": false
    }
  ],
  "captions": [
    {
      "from": 6,
      "to": 12,
      "text": "P-501A feeds the drum; LIC-502 holds drum level through LV-502."
    },
    {
      "from": 12,
      "to": 24,
      "text": "P-501A tripped; P-501B has taken over and level holds."
    }
  ],
  "events": [
    {
      "id": "trip",
      "says": "P-501A trips at midday.",
      "when": "hour >= 12",
      "then": [
        {
          "switch": "pumpA",
          "on": false
        }
      ],
      "at": "pA",
      "once": true
    },
    {
      "id": "standby",
      "says": "P-501B starts on the trip and takes the feed.",
      "when": "fired('trip')",
      "then": [
        {
          "switch": "pumpB",
          "on": true
        }
      ],
      "after": 0.1,
      "at": "pB"
    }
  ],
  "expect": [
    {
      "says": "before the trip P-501A is the duty pump",
      "check": "part('pA').out > 0 && part('pB').out < 0.01",
      "at": 10
    },
    {
      "says": "after the trip P-501A is stopped",
      "check": "part('pA').out < 0.01",
      "from": 14,
      "to": 23
    },
    {
      "says": "P-501B takes over after the trip",
      "check": "part('pB').out > 0",
      "from": 14,
      "to": 23
    },
    {
      "says": "the drum never runs dry",
      "check": "part('v502').fill > 0.2"
    },
    {
      "says": "the deaerator never overflows",
      "check": "part('d501').fill < 0.98"
    },
    {
      "says": "the deaerator never runs dry",
      "check": "part('d501').fill > 0.2"
    },
    {
      "says": "steam demand is always met",
      "check": "part('steam').in >= 0.999 * part('steam').demand"
    }
  ]
}
