{
  "anigram": 1,
  "id": "boiler-feedwater",
  "title": "Boiler Feedwater",
  "subtitle": "Deaerator, duty/standby boiler feed pumps and steam drum level control",
  "sheet": "PID-501",
  "size": [14, 5],
  "units": {
    "water": {
      "rate": "m³/h",
      "amount": "m³"
    },
    "electric": {
      "rate": "kW",
      "amount": "kWh"
    }
  },
  "scale": {
    "water": 60,
    "electric": 30
  },
  "parts": [
    {
      "id": "makeup",
      "kind": "river",
      "label": "Make-up water",
      "at": [0, 2],
      "behaviour": {
        "role": "source",
        "output": 80
      }
    },
    {
      "id": "power",
      "kind": "grid",
      "label": "Electricity",
      "at": [5, 4],
      "behaviour": {
        "role": "source",
        "output": 100,
        "dispatchable": true
      }
    },
    {
      "id": "lv501",
      "kind": "valve",
      "label": "Level control valve",
      "at": [1, 2],
      "behaviour": {
        "role": "gate",
        "capacity": 80,
        "open": "clamp((0.75 - prev('d501').fill) / 0.15, 0, 1)"
      },
      "tag": "LV-501",
      "class": "ControlValve"
    },
    {
      "id": "d501",
      "kind": "reservoir",
      "label": "Deaerator",
      "at": [3, 2],
      "behaviour": {
        "role": "storage",
        "capacity": 60,
        "start": 0.6,
        "maxIn": 80,
        "maxOut": 80,
        "refill": {
          "below": 0.65,
          "until": 0.75
        }
      },
      "tag": "D-501",
      "class": "Vessel"
    },
    {
      "id": "hdr1",
      "kind": "manifold",
      "label": "Suction header",
      "at": [4, 2],
      "behaviour": {
        "role": "bus"
      },
      "tag": "J-501",
      "class": "Junction"
    },
    {
      "id": "svA",
      "kind": "valve",
      "label": "Suction isolating valve",
      "at": [5, 1],
      "behaviour": {
        "role": "gate",
        "capacity": 60,
        "open": 1
      },
      "labelSide": "above",
      "tag": "HV-501A",
      "class": "GateValve"
    },
    {
      "id": "pA",
      "kind": "pump",
      "label": "Boiler feed pump A (duty)",
      "at": [6, 1],
      "behaviour": {
        "role": "converter",
        "output": "water",
        "recipe": {
          "electric": 0.3,
          "water": 1
        },
        "capacity": 60
      },
      "labelSide": "below",
      "tag": "P-501A",
      "class": "CentrifugalPump"
    },
    {
      "id": "ckA",
      "kind": "valve",
      "label": "Discharge check valve",
      "at": [7, 1],
      "behaviour": {
        "role": "gate",
        "capacity": 60,
        "open": "on('pumpA')"
      },
      "labelSide": "above",
      "tag": "CV-501A",
      "class": "CheckValve"
    },
    {
      "id": "dvA",
      "kind": "valve",
      "label": "Discharge isolating valve",
      "at": [8, 1],
      "behaviour": {
        "role": "gate",
        "capacity": 60,
        "open": 1
      },
      "labelSide": "below",
      "tag": "HV-502A",
      "class": "GateValve"
    },
    {
      "id": "svB",
      "kind": "valve",
      "label": "Suction isolating valve",
      "at": [5, 3],
      "behaviour": {
        "role": "gate",
        "capacity": 60,
        "open": 1
      },
      "labelSide": "below",
      "tag": "HV-501B",
      "class": "GateValve"
    },
    {
      "id": "pB",
      "kind": "pump",
      "label": "Boiler feed pump B (standby)",
      "at": [6, 3],
      "behaviour": {
        "role": "converter",
        "output": "water",
        "recipe": {
          "electric": 0.3,
          "water": 1
        },
        "capacity": 60
      },
      "labelSide": "above",
      "tag": "P-501B",
      "class": "CentrifugalPump"
    },
    {
      "id": "ckB",
      "kind": "valve",
      "label": "Discharge check valve",
      "at": [7, 3],
      "behaviour": {
        "role": "gate",
        "capacity": 60,
        "open": "on('pumpB')"
      },
      "labelSide": "below",
      "tag": "CV-501B",
      "class": "CheckValve"
    },
    {
      "id": "dvB",
      "kind": "valve",
      "label": "Discharge isolating valve",
      "at": [8, 3],
      "behaviour": {
        "role": "gate",
        "capacity": 60,
        "open": 1
      },
      "labelSide": "above",
      "tag": "HV-502B",
      "class": "GateValve"
    },
    {
      "id": "hdr2",
      "kind": "manifold",
      "label": "Common discharge",
      "at": [9, 2],
      "behaviour": {
        "role": "bus"
      },
      "tag": "J-502",
      "class": "Junction"
    },
    {
      "id": "lv502",
      "kind": "valve",
      "label": "Feed control valve",
      "at": [10, 2],
      "behaviour": {
        "role": "gate",
        "capacity": 60,
        "open": "clamp((0.7 - prev('v502').fill) / 0.15, 0, 1)"
      },
      "tag": "LV-502",
      "class": "ControlValve"
    },
    {
      "id": "v502",
      "kind": "reservoir",
      "label": "Steam drum",
      "at": [12, 2],
      "behaviour": {
        "role": "storage",
        "capacity": 40,
        "start": 0.6,
        "maxIn": 60,
        "maxOut": 60,
        "refill": {
          "below": 0.65,
          "until": 0.75
        }
      },
      "tag": "V-502",
      "class": "Vessel"
    },
    {
      "id": "steam",
      "kind": "factory",
      "label": "Steam to users",
      "at": [13, 2],
      "behaviour": {
        "role": "sink",
        "demand": "between(hour, 7, 19) ? 45 : 30"
      }
    }
  ],
  "links": [
    {
      "from": "makeup",
      "to": "lv501",
