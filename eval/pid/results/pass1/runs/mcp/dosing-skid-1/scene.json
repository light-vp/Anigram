  "captions": [
    {
      "from": 6,
      "to": 10,
      "text": "Morning peak: main flow rises and FIC-301 speeds up duty pump P-301A."
    },
    {
      "from": 10,
      "to": 16,
      "text": "Midday lull: dose falls with the main flow."
    },
    {
      "from": 16,
      "to": 21,
      "text": "Evening peak: the dose follows the main again as T-301 runs down."
    },
    {
      "from": 21,
      "to": 24,
      "text": "Overnight: low dose; the day tank still holds stock."
    }
  ],
  "expect": [
    {
      "says": "the dose follows the morning peak",
      "check": "part('p301a').out > 25",
      "at": 8
    },
    {
      "says": "the dose follows the evening peak",
      "check": "part('p301a').out > 25",
      "at": 18
    },
    {
      "says": "the dose is low overnight",
      "check": "part('p301a').out < 12",
      "at": 3
    },
    {
      "says": "standby pump P-301B stays idle",
      "check": "part('p301b').out < 0.001"
    },
    {
      "says": "the day tank runs down over the day",
      "check": "part('t301').fill < 0.8",
      "at": 23
    },
    {
      "says": "the day tank never runs dry",
      "check": "part('t301').fill > 0.15"
    }
