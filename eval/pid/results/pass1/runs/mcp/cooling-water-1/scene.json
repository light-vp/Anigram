{
  "anigram": 1,
  "id": "cooling-water",
  "title": "Cooling Water Circuit",
  "subtitle": "CT-601 basin, duty/standby pumps, E-601 and a TIC-601 tower bypass",
  "sheet": "PID-601",
  "size": [12, 8],
  "units": {
    "water": {
      "rate": "m³/h",
      "amount": "m³"
    },
    "electric": {
      "rate": "kW",
      "amount": "kWh"
    },
    "heat": {
      "rate": "MW",
      "amount": "MWh"
    }
  },
  "scale": {
    "water": 100,
    "electric": 30,
    "heat": 5
  },
  "parts": [
    {
      "id": "power",
      "kind": "grid",
      "label": "Electricity",
      "at": [3, 0],
      "behaviour": {
        "role": "source",
        "output": 100
      }
    },
    {
      "id": "mcca",
      "kind": "breaker",
      "label": "MCC A",
      "at": [2, 0],
      "behaviour": {
        "role": "gate",
        "capacity": 100,
        "open": "on('pa')"
      }
    },
    {
      "id": "mccb",
      "kind": "breaker",
      "label": "MCC B",
      "at": [4, 0],
      "behaviour": {
        "role": "gate",
        "capacity": 100,
        "open": "on('pb')"
      }
    },
    {
      "id": "ct",
      "kind": "reservoir",
      "label": "Cooling tower basin",
      "at": [0, 4],
      "behaviour": {
        "role": "storage",
        "capacity": 300,
        "start": 0.8,
        "maxIn": 300,
        "maxOut": 300,
        "refill": {
          "below": 0.95,
          "until": 1
        }
      },
      "labelSide": "below",
      "tag": "CT-601",
      "class": "Tank"
    },
    {
      "id": "cttop",
      "kind": "coolingtower",
      "label": "To tower top (CT-601 fill)",
      "at": [0, 1],
      "behaviour": {
        "role": "sink",
        "demand": 50
      },
      "labelSide": "right",
      "class": "OffPageConnector"
    },
    {
      "id": "js",
      "kind": "manifold",
      "label": "Suction header",
      "at": [1, 4],
      "behaviour": {
        "role": "bus"
      },
      "class": "Junction"
    },
    {
      "id": "sva",
      "kind": "valve",
      "label": "Suction isolation",
      "at": [2, 3],
      "behaviour": {
        "role": "gate",
        "capacity": 150,
        "open": 1
      },
      "labelSide": "above",
      "tag": "V-601A",
      "class": "GateValve"
    },
    {
      "id": "pa",
      "kind": "pump",
      "label": "Circ pump (duty)",
      "at": [3, 3],
      "behaviour": {
        "role": "converter",
        "output": "water",
        "recipe": {
          "electric": 0.2,
          "water": 1
        },
        "capacity": 100
      },
      "tag": "P-601A",
      "class": "CentrifugalPump"
    },
    {
      "id": "cva",
      "kind": "valve",
      "label": "Discharge check",
      "at": [4, 3],
      "behaviour": {
        "role": "gate",
        "capacity": 150,
        "open": 1
      },
      "labelSide": "above",
      "tag": "V-603A",
      "class": "CheckValve"
    },
    {
      "id": "dva",
      "kind": "valve",
      "label": "Discharge isolation",
      "at": [5, 3],
      "behaviour": {
        "role": "gate",
        "capacity": 150,
        "open": 1
      },
      "labelSide": "above",
      "tag": "V-604A",
      "class": "GateValve"
    },
    {
      "id": "svb",
      "kind": "valve",
      "label": "Suction isolation",
      "at": [2, 5],
      "behaviour": {
        "role": "gate",
        "capacity": 150,
        "open": 1
      },
      "labelSide": "below",
      "tag": "V-601B",
      "class": "GateValve"
    },
    {
      "id": "pb",
      "kind": "pump",
      "label": "Circ pump (standby)",
      "at": [3, 5],
      "behaviour": {
        "role": "converter",
        "output": "water",
        "recipe": {
          "electric": 0.2,
          "water": 1
        },
        "capacity": 100
      },
      "tag": "P-601B",
      "class": "CentrifugalPump"
    },
    {
      "id": "cvb",
      "kind": "valve",
      "label": "Discharge check",
      "at": [4, 5],
      "behaviour": {
        "role": "gate",
        "capacity": 150,
        "open": 1
      },
      "labelSide": "below",
      "tag": "V-603B",
      "class": "CheckValve"
    },
    {
      "id": "dvb",
      "kind": "valve",
      "label": "Discharge isolation",
      "at": [5, 5],
      "behaviour": {
        "role": "gate",
        "capacity": 150,
        "open": 1
      },
      "labelSide": "below",
      "tag": "V-604B",
      "class": "GateValve"
    },
    {
      "id": "jd",
      "kind": "manifold",
      "label": "Discharge header",
      "at": [6, 4],
      "behaviour": {
        "role": "bus"
      },
      "class": "Junction"
    },
    {
      "id": "e601",
      "kind": "valve",
      "label": "Plate heat exchanger (process stream cooler)",
      "at": [9, 4],
      "behaviour": {
        "role": "gate",
        "capacity": 150,
        "open": 1
      },
      "tag": "E-601",
      "class": "HeatExchanger"
    },
    {
      "id": "jr",
      "kind": "manifold",
      "label": "Return header",
      "at": [11, 4],
      "behaviour": {
        "role": "bus"
      },
      "class": "Junction"
    },
    {
      "id": "tv",
      "kind": "valve",
      "label": "Tower bypass valve",
      "at": [7, 7],
      "behaviour": {
        "role": "gate",
        "capacity": 60,
        "open": "clamp(0.75 - 0.55 * bump(hour, 15, 5), 0.1, 1)"
      },
      "labelSide": "right",
      "tag": "TV-601",
      "class": "ControlValve"
    },
    {
      "id": "fall",
      "kind": "river",
      "label": "Cooled water to basin",
      "at": [0, 2],
      "behaviour": {
        "role": "source",
        "output": "prev('cttop').in + prev('bw').in"
      },
      "labelSide": "right",
      "class": "OffPageConnector"
    },
    {
      "id": "bw",
      "kind": "river",
      "label": "Bypass to CT-601 basin",
      "at": [3, 7],
      "behaviour": {
        "role": "sink",
        "demand": "60 * clamp(0.75 - 0.55 * bump(hour, 15, 5), 0.1, 1)"
      },
      "labelSide": "above",
      "class": "OffPageConnector"
    }
  ],
  "links": [
