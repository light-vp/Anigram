  "instruments": [
    {
      "tag": "TT-601",
      "at": [7, 5],
      "measures": "jd",
      "reads": "24 + 7 * bump(hour, 15, 5)",
      "unit": "°C",
      "low": 18,
      "high": 32
    },
    {
      "tag": "TIC-601",
      "at": [7, 6],
      "measures": "TT-601",
      "drives": "tv",
      "mounting": "dcs"
    }
  ],
  "switches": [
    {
      "id": "pa",
      "label": "P-601A running",
      "on": true
    },
    {
      "id": "pb",
      "label": "P-601B running",
      "on": false
    }
  ],
  "captions": [
    {
      "from": 5,
      "to": 10,
      "text": "Cool morning: TV-601 passes plenty of warm return water to the basin."
    },
    {
      "from": 12,
      "to": 19,
      "text": "Hot afternoon: TV-601 closes down so more water goes up to the tower."
    }
  ],
  "expect": [
    {
      "says": "the duty pump P-601A runs all day",
      "check": "part('pa').out > 50"
    },
    {
      "says": "the standby pump P-601B stays idle",
      "check": "part('pb').out < 1"
    },
    {
      "says": "at 6 am TV-601 passes plenty of warm return water to the basin",
      "check": "part('tv').out > 40",
      "at": 6
    },
    {
      "says": "at 3 pm, when it is hotter, TV-601 passes much less",
      "check": "part('tv').out > 0 && part('tv').out < 20",
      "at": 15
    }
  ]
}
