{
  "anigram": 1,
  "id": "blend-skid",
  "title": "In-line blending skid",
  "subtitle": "Additive ratioed to base stock flow at 5% by FFIC-1202",
  "sheet": "PID-1200",
  "size": [8, 5],
  "units": {
    "fuel": {
      "rate": "m³/h",
      "amount": "m³"
    },
    "electric": {
      "rate": "kW",
      "amount": "kWh"
    }
  },
  "scale": {
    "fuel": 100,
    "electric": 30
  },
  "parts": [
    {
      "id": "base",
      "kind": "gaswell",
      "label": "Base stock from off sheet",
      "at": [0, 1],
      "behaviour": {
        "role": "source",
        "output": "40 + 50 * shift(hour) + 20 * bump(hour, 12, 2)"
      },
      "labelSide": "below"
    },
    {
      "id": "hv",
      "kind": "valve",
      "label": "Base stock isolation",
      "at": [2, 1],
      "behaviour": {
        "role": "gate",
        "capacity": 150,
        "open": 1
      },
      "tag": "HV-1201",
      "class": "BallValve"
    },
    {
      "id": "mix",
      "kind": "manifold",
      "label": "Static mixer",
      "at": [5, 1],
      "behaviour": {
        "role": "bus"
      },
      "labelSide": "above",
      "tag": "M-1201",
      "class": "Junction"
    },
    {
      "id": "t3",
      "kind": "fueltank",
      "label": "Blend tank",
      "at": [7, 1],
      "behaviour": {
        "role": "storage",
        "capacity": 5000,
        "start": 0.1,
        "maxIn": 200,
        "maxOut": 0,
        "refill": {
          "below": 0.99,
          "until": 1
        }
      },
      "tag": "T-1203",
      "class": "Tank"
    },
    {
      "id": "t2",
      "kind": "fueltank",
      "label": "Additive tank",
      "at": [0, 3],
      "behaviour": {
        "role": "storage",
        "capacity": 300,
        "start": 0.8,
        "maxIn": 0,
        "maxOut": 20
      },
      "tag": "T-1202",
      "class": "Tank"
    },
    {
      "id": "pwr",
      "kind": "grid",
      "label": "Electricity",
      "at": [1, 4],
      "behaviour": {
        "role": "source",
        "output": 10
      }
    },
    {
      "id": "p2",
      "kind": "pump",
      "label": "Additive pump",
      "at": [1, 3],
      "behaviour": {
        "role": "converter",
        "output": "fuel",
        "recipe": {
          "electric": 0.05,
          "fuel": 1
        },
        "capacity": 20
      },
      "tag": "P-1202",
      "class": "CentrifugalPump"
    },
    {
      "id": "fv",
      "kind": "valve",
      "label": "Additive control valve",
      "at": [3, 3],
      "behaviour": {
        "role": "gate",
        "capacity": 10,
        "open": "clamp(0.05 * prev('hv').out / 10, 0, 1)"
      },
      "tag": "FV-1202",
      "class": "ControlValve"
    }
  ],
  "links": [
    {
      "from": "base",
      "to": "hv",
      "domain": "fuel",
      "tag": "100-F-1201"
    },
    {
      "from": "hv",
      "to": "mix",
      "domain": "fuel",
      "tag": "100-F-1202"
    },
    {
      "from": "t2",
      "to": "p2",
      "domain": "fuel",
      "tag": "25-F-1203"
    },
    {
      "from": "pwr",
      "to": "p2",
      "domain": "electric"
    },
    {
      "from": "p2",
      "to": "fv",
      "domain": "fuel",
      "tag": "25-F-1204"
    },
    {
      "from": "fv",
      "to": "mix",
      "domain": "fuel",
      "via": [[5, 3]],
      "tag": "25-F-1205"
    },
    {
      "from": "mix",
      "to": "t3",
      "domain": "fuel",
      "tag": "100-F-1206"
    }
  ],
  "clock": {
    "start": 0,
    "rate": 1
  },
  "drawing": "pid",
  "titleBlock": {
    "owner": "Blending Plant",
    "project": "In-line blending skid",
    "drawnBy": "VP",
    "issued": "2026-10-17",
    "revision": "A",
    "status": "draft"
  },
  "instruments": [
    {
      "tag": "FT-1201",
      "at": [2, 0],
      "measures": "hv"
    },
    {
      "tag": "FT-1202",
      "at": [3, 2],
      "measures": "fv"
    },
    {
      "tag": "FFIC-1202",
      "at": [4, 2],
      "measures": "FT-1202",
      "drives": "fv",
      "mounting": "dcs"
    }
  ],
  "captions": [
    {
      "from": 0,
      "to": 24,
      "text": "Base stock is wild; FFIC-1202 keeps the additive at 5% of it."
    }
  ],
  "expect": [
    {
      "says": "additive flow follows base stock flow at 5% all day",
      "check": "abs(part('fv').out - 0.05 * part('hv').out) <= 0.02 * part('hv').out + 0.1"
    },
    {
      "says": "at the midday peak the additive is 5% of the base stock flow",
      "check": "part('fv').out > 4 && abs(part('fv').out / part('hv').out - 0.05) < 0.01",
      "at": 12
    },
    {
      "says": "overnight the additive falls with the base stock flow",
      "check": "part('fv').out < 2.5 && part('fv').out > 0",
      "at": 2
    },
    {
      "says": "the blend tank receives base plus additive",
      "check": "part('t3').in >= 1.04 * part('hv').out",
      "at": 12
    }
  ]
}
