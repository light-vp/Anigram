  "captions": [
    {
      "from": 6,
      "to": 11,
      "text": "P-4712 runs and pumps product from T-4750 to the 47126 header; P-4712B stands by."
    },
    {
      "from": 11,
      "to": 24,
      "text": "P-4712 has tripped; P-4712B is running and product still leaves the sheet."
    }
  ],
  "events": [
    {
      "id": "trip",
      "says": "P-4712 trips at 11:00.",
      "when": "hour >= 11",
      "then": [
        {
          "switch": "p-4712",
          "on": false
        }
      ],
      "at": "p-4712",
      "once": true
    },
    {
      "id": "standby",
      "says": "Low flow from P-4712 starts standby pump P-4712B.",
      "when": "fired('trip')",
      "then": [
        {
          "switch": "p-4712b",
          "on": true
        }
      ],
      "at": "p-4712b"
    }
  ],
  "expect": [
    {
      "says": "product keeps leaving the sheet every hour",
      "check": "part('off-page-connector-2').in >= 0.999 * part('off-page-connector-2').demand && part('off-page-connector-2').in > 0"
    },
    {
      "says": "before the trip P-4712 carries the duty and the standby is idle",
      "check": "part('p-4712').out > 0 && part('p-4712b').out < 0.001",
      "from": 7,
      "to": 10
    },
    {
      "says": "after the trip P-4712 is stopped and P-4712B carries the duty",
      "check": "part('p-4712').out < 0.001 && part('p-4712b').out > 0",
      "from": 12,
      "to": 23
