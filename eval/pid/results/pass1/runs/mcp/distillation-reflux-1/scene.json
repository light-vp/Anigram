  "expect": [
    {
      "says": "feed enters the column",
      "check": "part('c1101').in > 0",
      "sometime": true
    },
    {
      "says": "overhead vapour is condensed into the reflux drum",
      "check": "part('v1101').in > 0 && part('e1101').out > 0",
      "sometime": true
    },
    {
      "says": "the reflux pump returns reflux through FV-1101",
      "check": "part('fv1101').out > 0",
      "sometime": true
    },
    {
      "says": "distillate leaves through LV-1101 all day",
      "check": "part('dist').in > 0"
    },
    {
      "says": "the drum level is held mid-range",
      "check": "part('v1101').fill > 0.3 && part('v1101').fill < 0.9"
    },
    {
      "says": "steam heats the reboiler through TV-1102",
      "check": "part('tv1102').out > 0 && part('e1102').out > 0"
    },
    {
      "says": "bottoms leave through LV-1103 all day",
      "check": "part('btms').in > 0"
    },
    {
      "says": "the column sump level is held mid-range",
      "check": "part('c1101').fill > 0.3 && part('c1101').fill < 0.8"
    },
    {
      "says": "cooling water flows through PV-1104 to the condenser",
      "check": "part('pv1104').out > 0",
      "sometime": true
    }
  ]
}
