{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/sim/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["react", "react-dom", "**/view/**", "**/parts/**", "**/app/**", "../view/*", "../parts/*", "../app/*"],
                "message": "sim/ is the rulebook: React-free and view-free, so it runs headless in node (tests, scripts/simulate-day.ts)."
              }
            ]
          }
        ]
      }
    }
  ]
}
