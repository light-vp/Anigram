{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/engine/**/*.ts", "src/engine/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/packs/**",
                  "**/app/**",
                  "../packs/*",
                  "../../packs/*",
                  "../app/*",
                  "../../app/*"
                ],
                "message": "engine/ must stay domain-agnostic: it may not import from packs/ or app/. Packs register via registerPack()."
              }
            ]
          }
        ]
      }
    }
  ]
}
